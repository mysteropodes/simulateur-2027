<title>Simulateur des programmes 2027</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
/* Layout : bandeau de méthode, scénario + chocs, graphique multi-indicateurs, tableau comparatif, fiches candidats repliables, méthode. */
:root{
  --bg:#10131a; --side:#141822; --surface:#1a1f2b; --surface2:#222838; --ink:#eef0f5; --muted:#8f97ab; --soft:#7f889e; --line:#2a3142;
  --accent:#9db0ff; --accent-ink:#121a3d; --accent-soft:#232b45; --warn:#f0b23e; --good:#5fd3a2; --shock:#ff8a7a;
  --c0:#9aa3b2; --c1:#ef6f62; --c2:#5aa6e8; --c3:#f0b23e; --c4:#b484e0; --c5:#4cc7ae; --c6:#f48fb1; --c7:#b5e48c; --c8:#e8dcc4;
  --f-display:"Schibsted Grotesk",system-ui,sans-serif;
  --f-body:"Schibsted Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-data:"Schibsted Grotesk",system-ui,sans-serif;
  color-scheme:dark;
}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.55}
.wrap{max-width:1120px;margin:0 auto;padding-block:28px 56px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:28px}
h1,h2,h3{font-family:var(--f-display);font-stretch:85%;text-wrap:balance;margin:0;line-height:1.15}
h1{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800}
h2{font-size:1.35rem;font-weight:700}
h3{font-size:1.05rem;font-weight:700}
p{margin:0;max-width:68ch}
.lede{color:var(--muted)}
.eyebrow{font-family:var(--f-data);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
header{display:grid;gap:10px}
.notice{border-left:3px solid var(--warn);padding:10px 14px;background:var(--surface);font-size:.92rem}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:18px;display:grid;gap:14px;min-width:0}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin:4px 0 6px;overflow-x:auto}
.tabs button{font:600 .95rem var(--f-body);padding:10px 16px;border:0;border-bottom:3px solid transparent;background:none;color:var(--muted);cursor:pointer;white-space:nowrap}
.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media(max-width:520px){.tabs button{padding:10px 9px;font-size:.85rem}}
.tabpane,.tabs{min-width:0;max-width:100%}
.tabpane{display:grid;gap:22px}
.tabpane[hidden]{display:none}
.info p,.info li{max-width:72ch;line-height:1.6}
.info h3{margin:18px 0 6px;font-size:1.05rem}
.info ul{padding-left:20px;display:grid;gap:8px}
#tblcrisis th{text-align:left}
td.cr{font-family:var(--f-body);white-space:normal;text-align:left}
td.cr b{display:block;font-weight:600}
.seg{display:flex;flex-wrap:wrap;gap:8px}
.seg button{font:600 .88rem var(--f-body);padding:7px 13px;border-radius:4px;border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--surface)}
.seg.shock button[aria-pressed="true"]{background:var(--shock);border-color:var(--shock)}
button:focus-visible,input:focus-visible,summary:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.help{font-size:.88rem;color:var(--muted)}
.controls{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media (max-width:820px){.controls{grid-template-columns:1fr}}
.ctl{display:grid;gap:8px;min-width:0;align-content:start}
.chartbox{position:relative;height:420px;max-width:100%}
.chartcol{display:grid;gap:8px;min-width:0;align-content:start;align-self:start;position:sticky;top:12px}
.grid2{display:grid;grid-template-columns:2fr 1fr;gap:18px}
@media (max-width:820px){.grid2{grid-template-columns:1fr}.chartbox{height:300px}.chartcol{position:static}}
.sliders{display:grid;gap:12px;align-content:start}
.sl{display:grid;gap:4px}
.sl label{display:flex;justify-content:space-between;gap:8px;font-size:.88rem}
.sl output{font-family:var(--f-data);font-variant-numeric:tabular-nums;color:var(--accent)}
.sl small{color:var(--muted);font-size:.78rem}
input[type=range]{width:100%;accent-color:var(--accent)}
.tablewrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:900px;font-size:.88rem}
th,td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
th:first-child,td:first-child{text-align:left}
th{font-family:var(--f-data);font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:500;vertical-align:bottom}
th .grp{display:block;color:var(--ink);font-weight:500}
td{font-family:var(--f-data);font-variant-numeric:tabular-nums}
td.name{font-family:var(--f-body);font-weight:600}
td.sep,th.sep{border-left:1px solid var(--line)}
.sw{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:8px;vertical-align:middle}
.chip{font-family:var(--f-data);font-size:.74rem;padding:2px 7px;border-radius:3px;border:1px solid var(--line)}
.chip.ok{color:var(--good);border-color:var(--good)}
.chip.mid{color:var(--warn);border-color:var(--warn)}
.chip.bad{color:var(--c1);border-color:var(--c1)}
.better{color:var(--good)} .worse{color:var(--c1)}
details.cand{background:var(--surface);border:1px solid var(--line);border-radius:6px}
details.cand summary{cursor:pointer;padding:14px 18px;display:flex;align-items:center;gap:10px;font-weight:600;list-style:none}
details.cand summary::-webkit-details-marker{display:none}
details.cand summary::after{content:"+";margin-left:auto;font-family:var(--f-data);color:var(--muted)}
details.cand[open] summary::after{content:"–"}
.cbody{padding:0 18px 18px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media (max-width:720px){.cbody{grid-template-columns:1fr}}
.cbody ul{margin:0;padding-left:18px;display:grid;gap:4px;font-size:.9rem}
.src{font-size:.82rem;color:var(--muted)}
.iaplan{padding:4px 18px 8px;max-width:860px;display:grid;gap:14px;font-size:.92rem}
.iaplan>p{margin:0}
.psec{border-top:1px solid var(--line,#8884);padding-top:12px}
.psec h4{margin:0 0 6px;font-size:1.05rem;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.psec h5{margin:12px 0 4px;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.pnum{display:inline-grid;place-items:center;min-width:1.6em;height:1.6em;border-radius:50%;background:var(--c7,#7a5);color:#10131a;font-weight:700;font-size:.85rem}
.ptot{margin-left:auto;font-weight:600;font-size:.9rem;color:var(--muted)}
.plist{list-style:none;margin:0;padding:0;display:grid}
.plist li{display:grid;grid-template-columns:1fr auto;column-gap:14px;padding:7px 0;border-bottom:1px dashed var(--line,#8883)}
.plist .pl{min-width:0}
.plist .pn{grid-column:1/-1;font-size:.8rem;color:var(--muted);margin-top:2px}
.pamt{white-space:nowrap;font-size:.85rem;text-align:right;color:var(--muted)}
.pamt b{color:var(--fg,inherit)}
.pamt.r b,.pamt.up b{color:#2e9e5b}.pamt.c b{color:#c2711b}.pamt.down b{color:#c2413b}.pamt.z{font-style:italic}.pamt.no{color:#c2413b;font-weight:600;text-transform:uppercase;font-size:.72rem}
.pnego{display:grid;grid-template-columns:minmax(120px,190px) 1fr;gap:6px 14px;margin:0}
.pnego dt{font-weight:600}.pnego dd{margin:0}
@media (max-width:600px){.pnego{grid-template-columns:1fr}.pnego dd{margin-bottom:6px}.ptot{margin-left:0;width:100%}}

.cands{display:grid;gap:10px}
.chip.neutral{color:var(--muted)}
td.txt{font-family:var(--f-body);white-space:normal;min-width:140px;text-align:left}
.na{color:var(--muted)}
#tblcases td,#tblcases th{white-space:normal}
#tblcases .rng{max-width:170px;margin-left:auto}
#tblcases td.txt{max-width:220px}
.rng{display:block;font-size:.75rem;color:var(--muted)}
.xpgrid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.xp h3{display:flex;align-items:center;gap:8px;font-size:.95rem;margin:0 0 6px}
.xp ul{margin:0;padding-left:18px;display:grid;gap:6px;font-size:.88rem}
.bandrow{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:.85rem;color:var(--muted)}
.bandrow select{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:4px 8px}
table.mini{min-width:0;font-size:.82rem}
table.mini td,table.mini th{white-space:normal;padding:6px 8px}
table.mini td:first-child,table.mini td:last-child,table.mini th:last-child{font-family:var(--f-body);text-align:left}
.gridcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:14px}
.gcard{border:1px solid var(--line);border-radius:6px;padding:16px;display:grid;gap:14px;align-content:start;background:var(--bg);min-width:0}
.gcard h3{display:flex;align-items:center}
.grow{display:grid;gap:6px;padding-top:12px;border-top:1px solid var(--line)}
.grow p{font-size:.9rem}
.ghead{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.method{display:grid;gap:12px;font-size:.92rem}
.method ul{margin:0;padding-left:18px;display:grid;gap:6px;max-width:78ch}
.method h3{margin-top:4px}
a{color:var(--accent)}
.sharebar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px}
.reset{justify-self:start;font:600 .85rem var(--f-body);padding:6px 12px;border-radius:4px;border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
.costrank{margin-top:14px;padding-top:10px;border-top:1px solid rgba(128,128,128,.25)}
.cr-h{font-weight:600;margin-bottom:8px}.cr-h span{display:block;font-weight:400;font-size:.85em;opacity:.7}
.cr-r{display:grid;grid-template-columns:1.2em 10px minmax(8em,11em) 1fr 3em;gap:8px;align-items:center;font-size:.92em;margin:4px 0}
.cr-n{opacity:.6;text-align:right}.cr-c{width:10px;height:10px;border-radius:50%}
.cr-bar{height:8px;background:rgba(128,128,128,.18);border-radius:4px;overflow:hidden}.cr-bar i{display:block;height:100%;border-radius:4px}
.cr-x{font-style:italic}.cr-x b{font-style:normal;font-weight:600}
.cr-v{text-align:right;font-variant-numeric:tabular-nums}
.cr-d{grid-column:3/6;font-size:.8em;opacity:.65;margin:-2px 0 4px}
@media(max-width:520px){.cr-r{grid-template-columns:1.2em 10px 1fr 3em;row-gap:4px}.cr-name{grid-column:3/5;grid-row:1}.cr-bar{grid-column:3/4;grid-row:2}.cr-v{grid-column:4/5;grid-row:2}.cr-d{grid-column:3/5;grid-row:3}}
table.conseq{width:100%;min-width:0;border-collapse:collapse;font-size:.88em}table.conseq td{font-family:var(--f-body);white-space:normal;text-align:left}table.conseq td:first-child{font-weight:600;white-space:nowrap}table.conseq th,table.conseq td{padding:6px 8px;border-bottom:1px solid rgba(128,128,128,.2);vertical-align:top;text-align:left}table.conseq th{font-weight:600;opacity:.8}table.conseq .sw{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px}
.tblwrap{overflow-x:auto;max-width:100%}#conseq{min-width:0;max-width:100%}
#retroBody,#retroBody>*{min-width:0}.retro .seg{flex-wrap:wrap}.retro{margin:28px 0;padding-top:18px;border-top:1px solid var(--line)}.retro h3{margin:0 0 6px}.retroch{position:relative;height:300px;margin-top:10px}.retrot td,.retrot th{white-space:normal}.retrosum{background:rgba(128,128,128,.08);border-radius:8px;padding:10px 14px;margin:14px 0}.retrosum ul{margin:6px 0 0 18px;padding:0}

/* ---- Mise en page : menu latéral, vues, panneau d'hypothèses ---- */
body{margin:0;font-size:14.5px;font-variant-numeric:normal}
td,dd,output,.ovbig,.rob,.cr-v{font-variant-numeric:tabular-nums}
body.noscroll{overflow:hidden}
.panel{border-radius:14px;padding:18px 20px}
h1,h2,h3{font-stretch:normal;letter-spacing:-.01em}
h2{font-size:1.12rem;font-weight:650}
.eyebrow{text-transform:none;letter-spacing:0;font-size:.8rem;font-weight:600;color:var(--muted)}
.app{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh}
.side{background:var(--side);border-right:1px solid var(--line);padding:22px 14px;display:flex;flex-direction:column;gap:22px;position:sticky;top:0;height:100vh;overflow-y:auto}
.brand{display:flex;gap:11px;align-items:center;font-weight:700;font-size:15px;padding:0 6px}
.brand small{display:block;font-weight:400;color:var(--muted);font-size:12px}
.logo{flex:none;width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#2b3fa8,#9db0ff);display:grid;place-items:center;font-size:13px;color:#fff;font-weight:800}
.sidenav{display:grid;gap:18px}
.navgrp{display:grid;gap:2px}.navgrp>span{font-size:12px;color:var(--soft);font-weight:500;padding:0 10px 4px}
.navbtn{display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:8px 10px;border-radius:9px;border:0;background:none;color:var(--muted);font:500 14px var(--f-body);cursor:pointer}
.navbtn svg{width:17px;height:17px;flex:none;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
.navbtn:hover{color:var(--ink);background:rgba(255,255,255,.03)}
.navbtn[aria-current="page"]{background:var(--surface2);color:var(--ink)}
.navbtn:focus-visible,.chip:focus-visible,.btn-primary:focus-visible,.ovcard:focus-visible,.themes button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.sidefoot{margin-top:auto;font-size:12px;color:var(--soft);display:grid;gap:8px;padding:0 6px}.sidefoot p{max-width:none}
.main{padding:24px 30px 48px;min-width:0;display:grid;gap:18px;align-content:start}
.topbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.ttl{margin-right:auto;min-width:0}.ttl h1{font-size:1.6rem;font-weight:750}.ttl p{color:var(--muted);font-size:13.5px;margin-top:2px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:8px 12px;color:var(--ink);font:600 13px var(--f-body);cursor:pointer}
.chip span{color:var(--muted);font-weight:500;margin-right:6px}
.chip:hover{border-color:#3a4358}
.qz{max-width:760px;margin:0 auto;box-sizing:border-box;width:100%}
#quizBox{min-width:0}
.qz h2{font-size:1.35rem;margin:0 0 6px}
.qz-intro{display:grid;gap:14px;grid-template-columns:minmax(0,1fr)}
.qz-list{margin:0;padding-left:20px;display:grid;gap:8px}
.qz-prog{height:6px;background:var(--surface2);border-radius:3px;overflow:hidden}
.qz-prog i{display:block;height:100%;background:var(--accent)}
.qz-q{display:grid;gap:14px;grid-template-columns:minmax(0,1fr)}
.qz-step{margin:0;color:var(--muted);font-size:.85rem}
.qz-fs{border:0;padding:0;margin:0;display:grid;gap:10px;min-width:0}
.qz-fs legend{font-size:1.15rem;font-weight:650;line-height:1.35;padding:0;margin-bottom:4px}
.qz-opt{display:flex;gap:12px;align-items:flex-start;padding:13px 14px;border:1px solid var(--line);border-radius:8px;background:var(--bg);cursor:pointer}
.qz-opt:hover{border-color:var(--accent)}
.qz-opt:has(input:checked){border-color:var(--accent);background:var(--accent-soft)}
.qz-opt:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}
.qz-opt input{margin-top:4px;accent-color:var(--accent);flex:none}
.qz-opt strong{display:block;font-weight:600}
.qz-opt small{display:block;color:var(--muted);font-family:var(--f-data);font-size:.78rem;margin-top:2px}
.qz-skip{border-style:dashed}
.qz-imp{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.qz-imp[hidden]{display:none}
.qz-nav{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:9px 16px;font:600 13.5px var(--f-body);cursor:pointer}
.btn-ghost:hover{border-color:var(--accent)}
.btn-primary:disabled{opacity:.45;cursor:not-allowed}
.qz-res{display:grid;gap:16px;grid-template-columns:minmax(0,1fr)}
.qz-cards{display:grid;gap:14px;grid-template-columns:minmax(0,1fr)}
.qz-card{grid-template-columns:minmax(0,1fr);border:1px solid var(--line);border-left:4px solid var(--c,var(--accent));border-radius:8px;padding:16px;display:grid;gap:12px;background:var(--bg);min-width:0}
.qz-card header{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.qz-card h3{margin:0;font-size:1.1rem;flex:1;min-width:0}
.qz-card h3 small{color:var(--muted);font-weight:400}
.qz-card h4{margin:4px 0 0;font-size:.9rem;color:var(--muted);font-weight:600}
.qz-rk{width:28px;height:28px;border-radius:50%;background:var(--surface2);display:grid;place-items:center;font-weight:700;flex:none}
.qz-pct{font:700 1.4rem var(--f-data);text-align:right}
.qz-pct small{display:block;font:400 .72rem var(--f-body);color:var(--muted)}
.qz-warn{color:var(--warn)}
.qz-tab{min-width:0;font-size:.85rem;width:100%}
.qz-tab th,.qz-tab td{text-align:left;white-space:normal;padding:6px 8px}
.qz-tab em{font-style:normal;color:var(--accent);font-size:.72rem;border:1px solid var(--line);border-radius:3px;padding:0 4px}
.qz-dots{letter-spacing:2px;color:var(--accent);white-space:nowrap}
.qz-proj{display:grid;grid-template-columns:1fr auto;gap:6px 14px;margin:0;font-size:.88rem}
.qz-proj dt{color:var(--muted)}
.qz-proj dd{white-space:nowrap;margin:0;text-align:right;font-family:var(--f-data);font-variant-numeric:tabular-nums}
.qz-more summary{cursor:pointer;margin-bottom:10px}
.qz-fiche{justify-self:start}
.qz-answers{display:grid;gap:8px}
.qz-opt span{display:flex;align-items:center;gap:10px}
.qz-ic{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;font-weight:700;font-size:.85rem;flex:none;background:var(--surface2);color:var(--muted)}
.qz-ic1{background:var(--good-soft,#1f5f3f);color:var(--good,#8fe0b0)}.qz-ic-1,.qz-icm1{background:var(--bad-soft,#6a2a2a);color:var(--bad,#ffb0b0)}
.qz-dbl{display:flex;gap:8px;align-items:center;font-size:.9rem}
.qz-fx{border:1px solid var(--line);border-radius:8px;padding:12px 14px;background:var(--bg)}
.qz-fx h4{margin:0 0 8px;font-size:.95rem}
.qz-fx ul,.qz-mlist{list-style:none;margin:0 0 8px;padding:0;display:grid;gap:6px}
.qz-fx li span,.qz-mlist li span{flex:1 1 55%}
.qz-fx li,.qz-mlist li{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.9rem}
.qz-fx li strong,.qz-mlist li strong{text-align:right;font-family:var(--f-data);font-weight:600}
.qz-ranking{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.qz-rowc{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:4px 10px;align-items:center}
.qz-rowc .qz-barw{grid-column:2/3;height:8px;background:var(--surface2);border-radius:4px;overflow:hidden}
.qz-rowc .qz-barw i{display:block;height:100%;background:var(--c,var(--accent))}
.qz-rowc .qz-pct{grid-column:3;grid-row:1/3}
.qz-rowc .qz-cov{grid-column:2/4;color:var(--muted);font-size:.78rem}
.qz-nm small{color:var(--muted);font-weight:400}
.qz-mwrap{overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch}
.qz-mx{min-width:0;width:100%;font-size:.82rem;border-collapse:collapse}
.qz-mx th,.qz-mx td{padding:6px 6px;text-align:center;white-space:normal;border-bottom:1px solid var(--line)}
.qz-mx th:first-child,.qz-mx td:first-child{text-align:left;min-width:180px}
.qz-dets{display:grid;gap:8px}
.qz-det{border:1px solid var(--line);border-radius:8px;padding:8px 12px}
.qz-det summary{cursor:pointer;display:flex;gap:8px;align-items:center}
.qz-plist{list-style:none;padding:0;margin:10px 0;display:grid;gap:6px;font-size:.88rem}
.qz-plist li{display:flex;gap:8px;align-items:flex-start}
.qz-mine{display:grid;gap:10px;min-width:0}
.qz-caveat{min-width:0}
.qz-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:8px}
.qz-tiles span{background:var(--tc);color:#161616;border-radius:16px;padding:12px 8px;font:700 .8rem var(--f-display);font-stretch:85%;text-transform:uppercase;text-align:center;display:grid;gap:4px}
.qz-tiles b{font-size:1.5rem;font-weight:400}
.qz-go{min-height:52px;border-radius:999px;font-size:1rem}
.qz-top{display:grid;grid-template-columns:44px 1fr 44px;align-items:center}
.qz-x{width:44px;height:44px;border-radius:50%;border:0;background:transparent;color:var(--muted);font-size:1.8rem;line-height:1;cursor:pointer}
.qz-ring{justify-self:center;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--tc) calc(var(--p)*1%),var(--surface2) 0)}
.qz-ring span{width:44px;height:44px;border-radius:50%;background:var(--bg);display:grid;place-items:center;font:700 1rem var(--f-data)}
.qz-of{color:var(--muted);font-size:.8rem;text-align:right}
.qz-bubble{justify-self:center;width:132px;height:132px;border-radius:50%;background:var(--tc);display:grid;place-items:center;font-size:3.6rem}
.qz-step{text-align:center;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:var(--tc)}
.qz-q .qz-fs legend{text-align:center;font:700 1.35rem/1.25 var(--f-display);font-stretch:90%;width:100%;margin-bottom:10px}
.qz-pill{justify-content:center;align-items:center;padding:0 14px;min-height:54px;border-radius:999px;background:var(--surface2);border:2px solid transparent;text-align:center}
.qz-pill input{position:absolute;opacity:0;width:1px;height:1px}
.qz-pill span{justify-content:center;margin:0;padding:0}.qz-pill strong{display:inline}
.qz-pill:has(input:checked){background:var(--tc);border-color:var(--tc);color:#161616}
.qz-pill:has(input:checked) .qz-ic{background:#161616;color:#fff}
.qz-pill:has(input:focus-visible){outline:3px solid var(--ink);outline-offset:2px}
.qz-dbl{justify-content:center}
.qz-ctx{font-size:.88rem;color:var(--muted)}.qz-ctx summary{cursor:pointer;text-align:center}
.qz-q .qz-nav{padding:4px 0}
.qz-q .qz-nav .btn-primary,.qz-q .qz-nav .btn-ghost{min-height:48px;border-radius:999px;padding:0 22px}
.qz-q .qz-nav .btn-primary{flex:1}
.qz-rowc{background:color-mix(in srgb,var(--c) 16%,var(--surface2));border-radius:18px;padding:12px 14px}
.qz-rowc:first-child{background:var(--c);color:#161616}.qz-rowc:first-child .qz-cov,.qz-rowc:first-child .qz-nm small{color:#161616}.qz-rowc:first-child .qz-barw{background:rgba(0,0,0,.2)}.qz-rowc:first-child .qz-barw i{background:#161616}
.qz-res h2,.qz-intro h2{font-size:1.9rem;text-transform:uppercase;letter-spacing:.01em}
.qz-banner{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:12px 16px;border:1px solid var(--line);border-radius:8px;background:var(--accent-soft);margin-bottom:12px}
@media (max-width:600px){.qz-proj{grid-template-columns:1fr}.qz-proj dd{text-align:left}}
.btn-primary{background:var(--accent);color:var(--accent-ink);border:0;border-radius:10px;padding:9px 16px;font:650 13.5px var(--f-body);cursor:pointer}
.mnav{display:none}
.view{display:grid;gap:18px;min-width:0}.view[hidden]{display:none}
/* vue d'ensemble */
.ovcards{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:12px}
.ovcard{all:unset;box-sizing:border-box;cursor:pointer;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 14px 12px;position:relative;overflow:hidden;display:flex;flex-direction:column;min-width:0}
.ovcard::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:var(--c)}
.ovcard:hover{border-color:#3a4358}
.ovcard.ref{cursor:default;opacity:.7}
.ovn{font-weight:650;font-size:13.5px;display:flex;align-items:center;gap:7px}.ovn i{width:9px;height:9px;border-radius:50%;background:var(--c);flex:none}
.ovp{color:var(--muted);font-size:12px;margin-left:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ovtag{align-self:flex-start;margin:8px 0 0;font-size:11px;font-weight:600;color:var(--muted);border:1px dashed currentColor;border-radius:6px;padding:1px 6px}
.ovbig{font-size:29px;font-weight:750;letter-spacing:-.02em;margin-top:10px;line-height:1.1}
.ovlab{color:var(--muted);font-size:12px}
.ovcard dl{display:grid;grid-template-columns:1fr auto;gap:3px 8px;margin:12px 0 0;font-size:12.5px}
.ovcard dt{color:var(--muted)}.ovcard dd{margin:0;text-align:right;font-weight:600}
.ovnote{margin-top:-8px;font-size:12px;color:var(--soft);max-width:none}
.ovgrid{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(0,1fr);gap:18px;align-items:start}
.ovside{display:grid;gap:18px;min-width:0}
.chartpanel{gap:12px}
.chart-head{display:grid;gap:2px}
.themes{display:flex;gap:4px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:0}
.themes button{border:0;background:none;color:var(--muted);font:600 13px var(--f-body);padding:8px 10px;border-bottom:2px solid transparent;margin-bottom:-1px;cursor:pointer}
.themes button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.metricrow{gap:6px}
.seg button{border-radius:8px;background:transparent;font-weight:500;font-size:13px;padding:6px 11px;color:var(--muted)}
.seg button:hover{color:var(--ink);border-color:#3a4358}
.seg button[aria-pressed="true"]{background:var(--accent-soft);border-color:#4a5a9a;color:var(--ink)}
.seg.shock button[aria-pressed="true"]{background:rgba(255,138,122,.15);border-color:#8a4b45;color:var(--ink)}
.chartcol{position:static}
.chartbox{height:400px}
.take{margin:0;padding-left:18px;display:grid;gap:9px}.take li{line-height:1.45}
.rob{display:inline-block;font-size:11.5px;font-weight:600;border-radius:6px;padding:1px 6px;margin-left:4px;background:rgba(95,211,162,.14);color:var(--good)}
.rob.mid{background:rgba(240,178,62,.14);color:var(--warn)}
.costrank{margin:0;padding:0;border:0}
/* panneau d'hypothèses */
.scrim{position:fixed;inset:0;background:rgba(6,8,12,.55);z-index:20}
.drawer{box-sizing:border-box;position:fixed;top:0;right:0;bottom:0;width:min(440px,100vw);background:var(--surface);border-left:1px solid #3a4358;z-index:21;overflow-y:auto;padding:18px 20px 30px;display:grid;gap:14px;align-content:start;box-shadow:-20px 0 50px rgba(0,0,0,.4)}
.drawer[hidden],.scrim[hidden]{display:none}
.dhead{display:flex;gap:12px;align-items:flex-start}.dhead>div{flex:1;display:grid;gap:4px}
.dclose{border:1px solid var(--line);background:var(--surface2);color:var(--ink);border-radius:8px;width:32px;height:32px;font-size:20px;line-height:1;cursor:pointer}
.dtabs{display:flex;gap:4px;border-bottom:1px solid var(--line)}
.dtabs button{border:0;background:none;color:var(--muted);font:600 13.5px var(--f-body);padding:8px 10px;border-bottom:2px solid transparent;margin-bottom:-1px;cursor:pointer}
.dtabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.drawer .controls{grid-template-columns:1fr;gap:20px}
.dpane[hidden]{display:none}
input[type=range]{accent-color:#6f84f0}
table{font-size:.86rem}
th{font-family:var(--f-body);text-transform:none;letter-spacing:0;font-size:.78rem;font-weight:500;color:var(--soft)}
td{font-family:var(--f-body)}
.notice{border-left-color:var(--warn);border-radius:8px}
footer{margin:12px 0 0!important}
@media (max-width:1400px){.ovcards{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media (max-width:1100px){.ovgrid{grid-template-columns:1fr}}
@media (max-width:860px){
  .app{grid-template-columns:1fr}.side{display:none}
  .main{padding:16px}
  .mnav{display:flex;gap:6px;overflow-x:auto;margin:-4px -16px 0;padding:0 16px 4px;scrollbar-width:none}
  .mnav .navbtn{width:auto;white-space:nowrap;border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:13px}
  .mnav .navbtn[aria-current="page"]{background:var(--surface2);color:var(--ink);border-color:#3a4358}
  .ovcards{grid-template-columns:repeat(2,minmax(0,1fr))}
  .chartbox{height:300px}
  .ttl h1{font-size:1.35rem}
}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
#tblcrisis{table-layout:fixed;width:100%;min-width:0}#tblcrisis th:first-child,#tblcrisis td.name{width:24%;white-space:normal}
@media (max-width:820px){.tablewrap td.name,.tblwrap td.name,.tablewrap thead th:first-child,.tblwrap thead th:first-child{position:sticky;left:0;z-index:1;background:var(--surface);box-shadow:4px 0 6px -4px rgba(0,0,0,.6)}#tblcrisis{table-layout:auto;min-width:640px}}
@media (max-width:600px){.ovp{white-space:normal}.view .chartbox{height:440px}}
.xpd summary{cursor:pointer;list-style:none;display:grid;gap:2px;position:relative;padding-right:28px}.xpd summary::-webkit-details-marker{display:none}
.xpd summary::after{content:"+";position:absolute;right:0;top:0;font-size:20px;color:var(--muted)}.xpd[open] summary::after{content:"–"}
.xpd:not([open]){gap:0}
.ovcard dt{white-space:nowrap}
.cr-h{font-size:1.12rem}
.scenlab{font-size:12.5px;color:var(--soft);align-self:center;margin-right:2px}
.dd{position:relative}
.chip{display:flex;align-items:center;gap:6px}
.chip svg{width:12px;height:12px;fill:none;stroke:var(--muted);stroke-width:1.6}
.chip.changed{border-color:#4a5a9a;background:var(--accent-soft)}
.chip.changed::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accent);margin-right:2px}
.chip.flash{box-shadow:0 0 0 3px rgba(157,176,255,.45);transition:box-shadow .2s}
.ddmenu{position:absolute;top:calc(100% + 6px);left:0;z-index:15;min-width:250px;background:var(--surface2);border:1px solid #3a4358;border-radius:12px;padding:6px;box-shadow:0 14px 40px rgba(0,0,0,.45);display:grid;gap:2px}
.ddmenu button{display:flex;align-items:center;gap:8px;text-align:left;border:0;background:none;color:var(--ink);font:500 13.5px var(--f-body);padding:8px 10px;border-radius:8px;cursor:pointer}
.ddmenu button:hover,.ddmenu button:focus-visible{background:rgba(255,255,255,.06);outline:none}
.ddmenu button[aria-selected="true"]{background:var(--accent-soft)}
.ddmenu i{width:14px;font-style:normal;color:var(--accent);font-weight:700}
.ddmenu em{margin-left:auto;font-style:normal;font-size:11.5px;color:var(--soft)}
.chipreset{border:0;background:none;color:var(--accent);font:500 12.5px var(--f-body);cursor:pointer;text-decoration:underline;text-underline-offset:3px;padding:4px}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:#2b3fa8;color:#fff;padding:10px 16px;border-radius:10px;font:500 13.5px var(--f-body);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:30;max-width:calc(100vw - 32px);box-shadow:0 10px 30px rgba(0,0,0,.4)}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media (max-width:860px){.ddmenu{position:fixed;left:16px;right:16px;top:auto;min-width:0}}
@media (prefers-reduced-motion:reduce){.toast{transition:none}}
.ovcard dl{grid-template-columns:minmax(0,1fr) auto}.ovcard dd{white-space:nowrap}.ovcard dt{overflow:hidden;text-overflow:ellipsis}
/* thèmes (niveau 1) et indicateurs (niveau 2) bien distincts */
.themes{border:0;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:4px;gap:4px}
.themes button{border:0;margin:0;border-radius:9px;padding:8px 13px;font:650 13.5px var(--f-body);color:var(--muted)}
.themes button:hover{color:var(--ink);background:rgba(255,255,255,.04)}
.themes button[aria-selected="true"]{background:var(--accent);color:var(--accent-ink)}
.metrictray{border-left:3px solid var(--accent);background:rgba(157,176,255,.06);border-radius:0 10px 10px 0;padding:10px 12px;display:grid;gap:8px;margin-top:-2px}
.metrictray .trayl{font-size:12px;color:var(--muted)}.metrictray .trayl b{color:var(--ink);font-weight:600}
.metricrow button{font-size:12.5px;padding:5px 11px;border-radius:999px;border:1px solid var(--line);background:var(--surface);color:#b3bacb}
.metricrow button:hover{color:var(--ink);border-color:#3a4358}
.metricrow button[aria-pressed="true"]{background:transparent;border-color:var(--accent);color:var(--ink);font-weight:600}
.metricrow button[aria-pressed="true"]::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent);margin-right:6px;vertical-align:1px}
.ovcard dl{gap:3px 6px;font-size:12px}.ovcard{padding:13px 12px 11px}
.panel,.chartcol,.view,.main{grid-template-columns:minmax(0,1fr)}.chartbox{width:100%;min-width:0}.chartbox canvas{max-width:100%}
.atchips{display:grid;gap:10px}.atfam{display:flex;flex-wrap:wrap;gap:6px;align-items:center}.atfl{font:600 12px var(--f-body);color:var(--muted);min-width:180px}.atchips .chip{padding:5px 10px;font-size:12.5px}.atchips .chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--surface)}.atgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:14px}.atcard{border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:grid;gap:8px;align-content:start}.atcard h3{margin:0;font-size:1.02rem}.atcard p{margin:0;line-height:1.5}.atvs{color:var(--muted)}
.anbig{display:flex;gap:18px;align-items:center;border:1px solid var(--line);border-radius:12px;padding:14px 18px}.anbig>b{font-size:2.4rem;line-height:1;color:var(--worse,#ef6f62);white-space:nowrap}.anbig span{line-height:1.5}@media(max-width:600px){.anbig{flex-direction:column;align-items:flex-start}}
tr.me td{background:color-mix(in srgb,var(--accent) 12%,transparent)}
.attoc{display:flex;flex-wrap:wrap;gap:8px}.attoc a{font:600 12.5px var(--f-body);color:var(--ink);text-decoration:none;border:1px solid var(--line);border-radius:999px;padding:6px 12px}.attoc a:hover{border-color:var(--accent);color:var(--accent)}.ankpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:12px}.atbox{display:grid;gap:8px;align-content:start}.atbox h3{margin:0;font-size:1rem}.view[data-view="atlas"] details{border:1px solid var(--line);border-radius:10px;padding:10px 14px}.view[data-view="atlas"] summary{cursor:pointer;font-weight:600}.view[data-view="atlas"] details p,.view[data-view="atlas"] details ul{margin:10px 0 0}
.view[data-view="atlas"] table.mini td:not(:first-child),.view[data-view="atlas"] table.mini th:not(:first-child){white-space:nowrap}
.view[data-view="atlas"] .atcard table.mini td,.view[data-view="atlas"] .atcard table.mini th{white-space:normal}
.attoc .attg{flex-basis:100%;font:600 11.5px var(--f-body);letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-top:6px}.attoc .attg:first-child{margin-top:0}
.view[data-view="atlas"] table.polprob td:first-child,.view[data-view="atlas"] table.polprob th:first-child{min-width:250px;white-space:normal}
.view[data-view="atlas"] table.mini thead th{white-space:normal;vertical-align:bottom;min-width:64px}
.view[data-view="atlas"] table.polprob td:first-child,.view[data-view="atlas"] table.polprob thead th:first-child{position:sticky;left:0;background:var(--surface);z-index:1}
@media(max-width:600px){.view[data-view="atlas"] table.polprob td:first-child,.view[data-view="atlas"] table.polprob th:first-child{min-width:165px;max-width:165px}}
.view[data-view="atlas"] table.polprob td:first-child .rng,.view[data-view="atlas"] table.polprob th:first-child .rng{display:block;font-weight:400;margin-top:2px}
#anCrisis td:first-child{min-width:220px}
.polkpi .anbig{flex-direction:column;align-items:flex-start;gap:8px}
.view[data-view="atlas"] table.polprob th[colspan]{font:600 11.5px var(--f-body);letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--line)}
.view[data-view="atlas"] table.polprob td.polspan{white-space:normal;text-align:left;line-height:1.45;color:var(--ink)}
.view[data-view="atlas"] table.polcmp td,.view[data-view="atlas"] table.polcmp td .rng{white-space:normal}.view[data-view="atlas"] table.polcmp td:first-child{min-width:170px}.view[data-view="atlas"] table.polcmp td:last-child{min-width:200px;text-align:left}.view[data-view="atlas"] table.polcmp td:first-child,.view[data-view="atlas"] table.polcmp thead th:first-child{position:sticky;left:0;background:var(--surface);z-index:1}@media(max-width:600px){.view[data-view="atlas"] table.polcmp td:first-child{min-width:140px;max-width:140px}}
.view[data-view="atlas"] table.polprob .polspanm{display:none}
@media(max-width:600px){.view[data-view="atlas"] table.polprob td.polspan>div{display:none}.view[data-view="atlas"] table.polprob td:first-child .polspanm{display:block;margin-top:6px;line-height:1.45;color:var(--ink)}}
.view[data-view="atlas"] table.mini td.name{min-width:150px}
.polkpi{grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}.polkpi .anbig>b{font-size:2rem}
.poldet{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;margin-top:6px}.poldet>details{min-width:0}.poldet details>*:not(summary){margin-top:10px}
#metrics .diffbtn{margin-left:auto;border-style:dashed}
</style>

