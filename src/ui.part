const RPTS={restreint:6,mixte:3,neutre:0,renforce:1};
for(const c of CANDS0){ Object.assign(c,EXT[c.id]); c.rightsPts=c.grid?["egal","lib","cp"].reduce((s,k)=>s+RPTS[c.grid[k][0]],0):0; c.paMeasures=PA_MEASURES[c.id]; const ms=microsim(c.paMeasures); c.pa=ms.pa; c.paDec=ms.deciles; Object.assign(c,topFlows(c.paMeasures)); }

let BASE=structuredClone(BASE0), CANDS=structuredClone(CANDS0), mode="credible", metric="debt";
let encodeStateDefault=""; // état par défaut encodé, pour le lien de partage
const MODEHELP={annonce:"Chaque programme est appliqué à 100 %, comme le candidat l'annonce, sans recul face à la contestation. La réaction des marchés est quand même ajoutée.",credible:"Le candidat est élu et applique son programme : ses réformes (âge de départ, temps de travail, marché du travail) s'appliquent, mais seule la part jugée crédible des montants budgétaires se réalise. Les mesures touchant aux droits sont pondérées par la solidité juridique du programme.",pondere:"La part crédible est multipliée par la probabilité de pouvoir appliquer le programme (majorité, opinion, droit). C'est une moyenne, pas un scénario."};
const SHOCKHELP={none:"Pas de choc ponctuel.",petrole:"Prix du pétrole +45 $ pendant un an, +25 $ l'année suivante (type 2022) : facture énergétique, inflation, aides publiques ; l'effet dépend de la dépendance aux énergies fossiles.",commerce:"Guerre commerciale : −0,4 point de PIB cumulé sur trois ans (Banque de France, droits de douane américains de 2025).",taiwan:"Blocus de Taïwan : −3 points de croissance, inflation +1,5 point, tensions sur les taux (ordre de grandeur très incertain).",recession:"Croissance −3 points, rebond partiel ensuite (type 2009).",financial:"Croissance −2 points, taux +2 points sur trois ans, confrontation avec l'UE plus coûteuse (type 2011-2012).",inflation:"Inflation +3 puis +1,5 point, croissance −1 point (type 2022-2023).",climat:"Canicule ou inondations majeures : croissance −1,5 point, déficit +1 point, environ 10 000 décès (type 2003).",pandemie:"Croissance −7 points puis rebond, déficit +5 puis +2 points, environ 75 000 décès sur deux ans (type 2020)."};
const CLIMHELP={moderee:"Dommages limités : −0,03 point de croissance par an, décès liés à la chaleur +2 % par an.",forte:"Dommages notables : −0,07 point par an, décès liés à la chaleur +4 % par an.",tresforte:"Dommages lourds : −0,12 point par an, décès liés à la chaleur +6 % par an."};
const AIHELP={lente:"Gains de productivité +0,1 point par an, pertes d'emplois au pic +0,5 point de chômage.",moyenne:"Gains +0,3 point par an, pertes d'emplois au pic +1,2 point de chômage.",rapide:"Gains +0,6 point par an, pertes d'emplois au pic +2,5 points de chômage."};
const METRICS={debt:["Dette","% du PIB",1,"%"],ca:["Solde extérieur courant","% du PIB",1,"%"],defEtat:["Déficit de l'État","% du PIB, avant compensations",1,"%"],defSecu:["Déficit de la Sécurité sociale","% du PIB, avant compensations",1,"%"],defLoc:["Déficit des collectivités","% du PIB",1,"%"],house:["Prix des logements","indice réel, 2025 = 100",0,""],rent:["Loyers","indice réel, 2025 = 100",0,""],inh:["Héritages et donations","% du PIB",1,"%"],succ:["Droits de succession","% du PIB",2,"%"],brent:["Prix du pétrole","$ du baril (constants)",0," $"],mig:["Actifs liés au solde migratoire","milliers, écart à la tendance",0," k"],icf:["Fécondité","enfants par femme",2,""],births:["Naissances","milliers par an",0," k"],def:["Déficit","% du PIB",1,"%"],unemp:["Chômage","% des actifs",1,"%"],pov:["Pauvreté","% de la population",1,"%"],prisonD:["Densité carcérale","détenus pour 100 places",0,""],judgeLoad:["Charge des juges","affaires par magistrat, 2025 = 100",0,""],theftI:["Vols et cambriolages","indice, 2025 = 100 (fourchette large)",0,""],secCost:["Coût des mesures justice et sécurité","Md€ par an, hors chiffrage des candidats",1,""],povA:["Pauvreté, seuil figé","% de la population sous le seuil de 2025 (euros constants)",1,"%"],gini:["Inégalités","indice de Gini",3,""],health:["Santé","mois d'espérance de vie",1," mois"],heat:["Décès en excès","décès par an",0,""],tension:["Tension sociale","indice 0-100",0,""],burden:["Charge d'intérêts","% des recettes publiques",1,"%"],co2:["Gaz à effet de serre","MtCO₂e par an",0,""],pm:["Décès dus à la pollution de l'air","décès par an",0,""],pens:["Solde des retraites","% du PIB",2,"%"],retliv:["Niveau de vie des retraités","% de celui de l'ensemble",1,"%"],nw:["Patrimoine net des administrations publiques","% du PIB",1,"%"],spread:["Écart de taux avec l'Allemagne","points de pourcentage, 10 ans",2,""],defense:["Dépense de défense","% du PIB (définition OTAN)",2,"%"],growth:["Croissance du PIB","% par an, en volume",1,"%"],infl:["Inflation","% par an",1,"%"],youth:["Chômage des 15-24 ans","% des actifs de 15-24 ans",1,"%"],po:["Prélèvements obligatoires","% du PIB",1,"%"],dep:["Dépense publique","% du PIB",1,"%"],energy:["Facture énergétique","Md€ par an",0,""],artif:["Terres artificialisées","hectares par an",0,""],cons:["Logements mis en chantier","milliers par an",0,""],sp:["Services publics","% du PIB",1,"%"],ratioEl:["Écart riches-modestes, services publics compris","revenu des 10 % les plus aisés / 10 % les plus modestes",2,""],emp55:["Emploi des 55-64 ans","taux d'emploi, %",1,"%"],w10:["Patrimoine des 10 % les plus riches","% du patrimoine brut total",1,"%"]};

const YEARS=Array.from({length:END-START+1},(_,k)=>String(START+k));
const yi=y=>y-START;
const css=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const fmt=(x,d=1)=>{const k=Math.pow(10,d);if(Math.round(x*k)===0)x=0;return x.toLocaleString("fr-FR",{minimumFractionDigits:d,maximumFractionDigits:d});};
let chart;
function rFB(p){return simulate(p,"credible",Object.assign({},BASE,{premPol:0,lpm:0,premPolDecay:0.8}));}
const GOV={def:{2026:5.4,2027:5.0,2028:4.0,2029:2.9},debt:{2026:119.2,2027:121.7}};
function fillOfficial(res){
  const tb=document.querySelector("#tblofficial tbody"); if(!tb) return; const r=res[0].r;
  const gdp27=BASE.gdpMd*(1+r.growth[yi(2026)]/100)*(1+r.infl[yi(2026)]/100)*(1+r.growth[yi(2027)]/100)*(1+r.infl[yi(2027)]/100);
  const rows=[["Croissance 2026","0,4 % (Banque de France, septembre 2026, choc d'Ormuz compris) ; 0,5 % (gouvernement)",fmt(r.growth[yi(2026)])+" %"],
    ["Croissance 2027","0,9 % (Banque de France) ; 0,8 % (consensus) ; 1,0 % (gouvernement)",fmt(r.growth[yi(2027)])+" %"],
    ["Inflation 2026 et 2027","2,3 % puis 1,9 % (IPCH, Banque de France)",fmt(r.infl[yi(2026)])+" % puis "+fmt(r.infl[yi(2027)])+" %"],
    ["Chômage 2026 et 2027","8,3 % (Banque de France)",fmt(r.unemp[yi(2026)])+" % puis "+fmt(r.unemp[yi(2027)])+" %"],
    ["Prix du pétrole 2026 et 2027","96 $ puis 84 $ (EIA, octobre 2026)",fmt(r.brent[yi(2026)],0)+" $ puis "+fmt(r.brent[yi(2027)],0)+" $"],
    ["Déficit 2026","5,4 % (gouvernement)",fmt(r.def[yi(2026)])+" %"],
    ["Déficit 2027 sans nouvelles économies","environ 6,5 % (Premier ministre)",fmt(r.def[yi(2027)])+" %"],
    ["Charge d'intérêts 2027","91 Md€ (PLF 2027)",fmt(r.burden[yi(2027)]*BASE.rev/100*gdp27/100,0)+" Md€"],
    ["Dette 2027","environ 122 % avec les économies prévues (HCFP)",fmt(r.debt[yi(2027)])+" % sans économies"]];
  tb.innerHTML=rows.map(x=>`<tr><td class="txt">${x[0]}</td><td class="sep txt">${x[1]}</td><td class="sep">${x[2]}</td></tr>`).join("");
}
const fogZone={id:"fogZone",beforeDatasetsDraw(c){const a=c.chartArea,g=c.ctx,x=c.scales.x.getPixelForValue(yi(2032));if(!(x>a.left&&x<a.right))return;
  g.save();g.fillStyle=css("--line");g.globalAlpha=0.28;g.fillRect(x,a.top,a.right-x,a.bottom-a.top);g.globalAlpha=1;g.fillStyle=css("--muted");g.font="11px 'IBM Plex Mono', monospace";g.textAlign="left";g.fillText("après 2032 : tendances, pas prévisions",x+6,a.bottom-8);g.restore();}};
const shockLine={id:"shockLine",afterDatasetsDraw(c){
  if(BASE.shock==="none")return; const x=c.scales.x.getPixelForValue(yi(BASE.shockYear)), a=c.chartArea, g=c.ctx, right=x>a.right-80;
  g.save();g.strokeStyle=css("--shock");g.setLineDash([4,4]);g.beginPath();g.moveTo(x,a.top);g.lineTo(x,a.bottom);g.stroke();
  g.fillStyle=css("--shock");g.font="12px 'IBM Plex Mono', monospace";g.textAlign=right?"right":"left";g.fillText("choc",x+(right?-6:6),a.top+14);g.restore();}};
function render(skipMC){
  if(typeof updateShareURL==="function"&&encodeStateDefault) updateShareURL();
  for(const c of CANDS){const ms=microsim(c.paMeasures,mode==="annonce"?0:BASE.leak); c.pa=ms.pa; c.paDec=ms.deciles;}
  const res=CANDS.map(p=>({p,r:simulate(p,mode,BASE)}));
  LASTRES=res;
  if(typeof buildConseq==="function") buildConseq(res);
  const [mlabel,unit,dec,suf]=METRICS[metric];
  const ink=css("--muted"), line=css("--line");
  const ds=res.map(({p,r})=>{const evY=new Set(r.ev.filter(e=>EVMET[e.k]&&(EVMET[e.k]||[]).includes(metric)).map(e=>e.t));return {label:p.name,data:r[metric].map(v=>v==null?null:+v.toFixed(dec+1)),borderColor:css(p.color),backgroundColor:css(p.color),borderWidth:p.id==="statu"?2:2.5,borderDash:p.id==="statu"?[6,4]:p.fictif?[2,3]:[],pointRadius:YEARS.map(y=>evY.has(+y)?4.5:0),pointBorderColor:css("--surface"),pointBorderWidth:1.5,pointHoverRadius:4,tension:.25,spanGaps:true};});
  addBand(ds);
  if(GOV[metric]){const g=GOV[metric];ds.push({label:"Trajectoire du gouvernement",isGov:true,data:YEARS.map(y=>g[+y]??null),borderColor:css("--ink"),backgroundColor:css("--ink"),borderWidth:1.5,borderDash:[2,3],pointRadius:3,pointStyle:"rectRot",spanGaps:true,tension:0});}
  if(typeof Chart!=="undefined"){ if(!chart){
    Chart.defaults.font.family=getComputedStyle(document.body).fontFamily;chart=new Chart(document.getElementById("chart"),{type:"line",data:{labels:YEARS,datasets:ds},plugins:[shockLine,fogZone],
      options:{responsive:true,maintainAspectRatio:false,animation:{duration:250},interaction:{mode:"index",intersect:false},
        plugins:{legend:{position:"bottom",labels:{boxWidth:12,filter:(l,d)=>!d.datasets[l.datasetIndex].isBand}},
          tooltip:{filter:it=>!it.dataset.isBand,callbacks:{label:c=>`${c.dataset.label} : ${fmt(c.parsed.y,METRICS[metric][2])}${METRICS[metric][3]}`,footer:items=>tipFooter(items)}}},
        scales:{x:{ticks:{maxTicksLimit:12}},y:{title:{display:true}}}}});
  }
  chart.data.datasets=ds;
  chart.options.plugins.legend.labels.color=ink;
  for(const a of ["x","y"]){chart.options.scales[a].ticks.color=ink;chart.options.scales[a].grid={color:line};}
  chart.options.scales.y.ticks.callback=(v,i,ticks)=>{const st=ticks.length>1?Math.abs(ticks[1].value-ticks[0].value):1;const d=st>=1?0:st>=0.1?1:st>=0.01?2:3;return fmt(v,d)+(suf==="%"?" %":"");};
  chart.options.scales.y.title.text=unit; chart.options.scales.y.title.color=ink;
  chart.update(); }
  explain(res);
  if(skipMC!==true) scheduleMC();
  fillSenior(res);
  fillHousing(res);
  fillEco(res);
  fillIntl(res);
  buildDeciles();
  const sq=res[0].r;
  const peak=(arr)=>Math.max(...arr.slice(yi(2027),yi(2036)+1));
  const sum=(arr)=>arr.slice(yi(2027)).reduce((a,b)=>a+b,0);
  const cls=(v,ref,lowerBetter=true,eps=0.05)=>{const dl=v-ref; if(Math.abs(dl)<eps)return ""; return (dl<0)===lowerBetter?"better":"worse";};
  const nameCell=p=>`<td class="name"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td>`;
  const signed=(v,d=1)=>(v>0?"+":v<0?"−":"")+fmt(Math.abs(v),d);
  const fill=(id,rowFn)=>{const tb=document.querySelector(`#${id} tbody`);tb.innerHTML="";for(const x of res){const tr=document.createElement("tr");tr.innerHTML=rowFn(x);tb.appendChild(tr);}};
  const ncCache={}, sq0=res[0].p, nc=pp=>ncCache[pp.id]||(ncCache[pp.id]=simulate(pp,mode,Object.assign({},BASE,{crisisPrem:1e9}))); // même scénario sans crise de financement
  fill("tbl",({p,r})=>{const q=p.id==="statu", c=(v,ref,lb,eps)=>q?"":cls(v,ref,lb,eps);
    return nameCell(p)+`<td>${q?"–":fmt(p.c,2)}</td><td>${q?"–":fmt(r.f,2)}</td>
      <td class="sep ${c(r.def[yi(2031)],sq.def[yi(2031)])}">${fmt(r.def[yi(2031)])} %</td>
      <td class="${c(r.debt[yi(2036)],sq.debt[yi(2036)],true,0.5)}">${fmt(r.debt[yi(2036)])} %</td>
      <td class="${c(r.debt[yi(2046)],sq.debt[yi(2046)],true,0.5)}">${fmt(r.debt[yi(2046)])} %</td>
      <td class="${c(nc(p).debt[yi(2046)],nc(sq0).debt[yi(2046)],true,0.5)}">${fmt(nc(p).debt[yi(2046)],0)} %</td>
      <td class="${c(r.burden[yi(2036)],sq.burden[yi(2036)],true,0.2)}">${fmt(r.burden[yi(2036)])} %</td>
      <td class="${c(r.pens[yi(2032)],sq.pens[yi(2032)],false,0.05)}">${signed(r.pens[yi(2032)],2)} %</td>
      <td class="sep">${r.crisis!==null?`<span class="chip bad">crise ${r.crisis}${r.crisisN>1?` et ${r.crisisLast}`:""}</span>`:r.tpi!==null?`<span class="chip mid">filet BCE ${r.tpi}</span>`:`<span class="chip ok">accès normal</span>`}</td>`;});
  fill("tbl2",({p,r})=>{const q=p.id==="statu", c=(v,ref,lb,eps)=>q?"":cls(v,ref,lb,eps);
    const pmD=sum(r.pm)-sum(sq.pm);
    return nameCell(p)+`<td class="${c(r.unemp[yi(2030)],sq.unemp[yi(2030)])}">${fmt(r.unemp[yi(2030)])} %</td>
      <td class="${c(r.pov[yi(2032)],sq.pov[yi(2032)])}">${fmt(r.pov[yi(2032)])} %</td>
      <td class="${c(r.gini[yi(2032)],sq.gini[yi(2032)],true,0.0005)}">${fmt(r.gini[yi(2032)],3)}</td>
      <td class="${c(r.retliv[yi(2032)],sq.retliv[yi(2032)],false,0.1)}">${fmt(r.retliv[yi(2032)])} %</td>
      <td class="sep ${c(r.health[yi(2036)],sq.health[yi(2036)],false,0.1)}">${signed(r.health[yi(2036)])} mois</td>
      <td class="${c(sum(r.heat),sum(sq.heat),true,500)}">${fmt(sum(r.heat)/1000,0)} 000</td>
      <td class="${q?"":(Math.abs(pmD)<500?"":pmD<0?"better":"worse")}">${q?"référence":signed(pmD/1000,0)+" 000"}</td>
      <td class="sep ${c(r.co2[yi(2032)],sq.co2[yi(2032)],true,1)}">${fmt(r.co2[yi(2032)],0)}</td>
      <td class="${c(r.co2[yi(2046)],sq.co2[yi(2046)],true,1)}">${fmt(r.co2[yi(2046)],0)}</td>
      <td class="sep ${c(Math.max(...r.tension),Math.max(...sq.tension),true,1)}">${fmt(Math.max(...r.tension),0)}</td>`;});
  fill("tbl3",({p,r})=>{const q=p.id==="statu";
    return nameCell(p)+GROUPS.map(([g],i)=>{let v=(r.pa[g][yi(2032)]/sq.pa[g][yi(2032)]-1)*100;if(Math.abs(v)<0.05)v=0;
      return `<td class="${i===0?"sep ":""}${q||Math.abs(v)<0.05?"":v>0?"better":"worse"}">${q?"référence":signed(v)+" %"}</td>`;}).join("");});
  const fbRes=CANDS.map(p=>({p,r:simulate(p,"credible",BASE)})).filter(x=>x.p.fb);
  const tbf=document.querySelector("#tblfb tbody");tbf.innerHTML="";
  for(const {p,r} of fbRes){const tr=document.createElement("tr");
    tr.innerHTML=nameCell(p)+`<td class="sep">${fmt(-p.fb.def)} %</td><td>${fmt(r.def[yi(2030)])} %</td>
      <td class="sep">${fmt(p.fb.debt,0)} %</td><td>${fmt(r.debt[yi(2030)],0)} %</td>
      <td class="sep">${fmt(p.fb.unemp)} %</td><td>${fmt(r.unemp[yi(2030)])} %</td>
      <td class="sep">${fmt(p.fb.gini,3)}</td><td>${fmt(r.gini[yi(2030)],3)}</td>
      <td class="sep">${fmt(p.fb.pa)}</td><td class="sep">${fmt(rFB(p).def[yi(2030)])} %</td><td>${fmt(rFB(p).debt[yi(2030)],0)} %</td><td class="src">${p.fb.note||""}</td>`;tbf.appendChild(tr);}
  fillOfficial(res); buildOverview(res,nc); updateChips();
  document.getElementById("modehelp").textContent=MODEHELP[mode];
  document.getElementById("shockhelp").textContent=SHOCKHELP[BASE.shock];
  document.getElementById("climhelp").textContent=CLIMHELP[BASE.clim];
  document.getElementById("energyhelp").textContent=ENERGYTXT[BASE.energy];
  document.getElementById("aihelp").textContent=AIHELP[BASE.ai];
  document.getElementById("shockYear").disabled=BASE.shock==="none";
}
const GL=[["realg",v=>fmt(v)+" %"],["infl",v=>fmt(v)+" %"],["mktReal",v=>fmt(v)+" %"],["mult",v=>fmt(v)],["prem",v=>"+"+fmt(v,2)+" pt"],["redistEff",v=>fmt(v,2)],["multScale",v=>"× "+fmt(v,2)],["hyst",v=>fmt(v*100,0)+" %"],["ineqGrowth",v=>"−"+fmt(v,2)+" pt"],["tpiDef",v=>fmt(v,1)+" %"],["ecb",v=>fmt(v,2)],["climCost",v=>"× "+fmt(v,1)],["ageCost",v=>"+"+fmt(v,1)+" pt"],["povSave",v=>fmt(v,2)+" Md€"],["natoGap",v=>"+"+fmt(v,2)+" pt"],["phil",v=>fmt(v,2)],["smicEl",v=>"−"+fmt(v,2)],["extScale",v=>"× "+fmt(v,1)],["rcSupply",v=>"−"+fmt(v*100,0)+" %"],["rcRent",v=>"−"+fmt(v,0)+" %"],["ageEff",v=>fmt(v*100,0)+" %"],["migFisc",v=>(v>0?"+":"")+fmt(v,2)+" pt"],["migWork",v=>fmt(v*100,0)+" %"],["oilGdp",v=>"−"+fmt(v*10,1)+" %"],["importSub",v=>fmt(v*100,0)+" %"],["transDrag",v=>"−"+fmt(v,2)+" pt"],["oilPi",v=>"+"+fmt(v*10,1)+" pt"],["bouclier",v=>fmt(v*100,0)+" %"],["oilCoupling",v=>fmt(v,2)],["icfRef",v=>fmt(v,2)],["famElast",v=>fmt(v,3)],["climNeed",v=>fmt(v)+" pt"],["kDebt",v=>"+"+fmt(v,2)+" pt"],["crisisPrem",v=>fmt(v)+" pts"],["premPol",v=>"+"+fmt(v)+" pt"],["premPolDecay",v=>"−"+fmt((1-v)*100,0)+" %/an"],["leak",v=>fmt(v*100,0)+" %"],["seniorKeep",v=>fmt(v*100,0)+" %"],["tensionRights",v=>fmt(v,1)],["forcedMax",v=>fmt(v,0)+" pts"],["spRet",v=>fmt(v,2)],["invRet",v=>fmt(v,2)],["fiscalReact",v=>fmt(v,2)],["aiCost",v=>fmt(v,1)+" pt"],["rtt",v=>fmt(v*100,0)+" %"],["shockYear",v=>String(v)]];
function syncSeg(attr,val){document.querySelectorAll(`[data-${attr}]`).forEach(b=>b.setAttribute("aria-pressed",b.dataset[attr]===val));}
function bindGlobals(){
  for(const [k,f] of GL){const el=document.getElementById(k),o=document.getElementById("o-"+k);
    el.value=BASE[k];o.textContent=f(+el.value);el.oninput=()=>{BASE[k]=+el.value;o.textContent=f(+el.value);render()};}
  syncSeg("shock",BASE.shock);syncSeg("clim",BASE.clim);syncSeg("ai",BASE.ai);syncSeg("energy",BASE.energy);syncSeg("exit",BASE.exit);
}
const PS=[["A","Effort annoncé (pt de PIB)",-1,6,0.1,v=>fmt(v)],["migDelta","Solde migratoire, écart à la tendance (milliers/an)",-200,100,10,v=>(v>0?"+":"")+fmt(v,0)],["famMd","Politique familiale, dépense nette en plus (Md€/an)",-10,30,1,v=>(v>0?"+":"")+fmt(v,0)],["c","Crédibilité du chiffrage",0,1,0.05,v=>fmt(v,2)],["parl","Chances d'une majorité",0,1,0.05,v=>fmt(v,2)],["adh","Soutien de l'opinion",0,1,0.05,v=>fmt(v,2)],["legal","Solidité juridique",0,1,0.05,v=>fmt(v,2)],["eu","Prime de confrontation UE (pt)",0,2,0.1,v=>fmt(v)],["longRun","Croissance de long terme (pt/an)",-0.3,0.4,0.01,v=>fmt(v,2)],["climInv","Investissement climat (pt PIB/an)",0,2,0.05,v=>fmt(v,2)],["healthSpend","Dépenses de santé en plus (pt PIB)",-0.6,0.6,0.05,v=>fmt(v,2)],["aiCushion","Amortisseur IA (0-1)",0,1,0.05,v=>fmt(v,2)],["aiAdopt","Rythme d'adoption de l'IA",0.6,1.4,0.05,v=>fmt(v,2)],["co2Rate","Baisse des émissions (%/an)",0,8,0.1,v=>fmt(v)],["pensBal","Effet sur le solde des retraites (pt PIB)",-1.5,1.5,0.05,v=>fmt(v,2)],["retLiv","Effet sur le niveau de vie des retraités (pts)",-5,5,0.5,v=>fmt(v)],["ageShift","Changement de l'âge de départ (années)",-4,2,0.5,v=>(v>0?"+":"")+fmt(v)],["housing","Logements en plus par an (milliers)",-50,150,5,v=>(v>0?"+":"")+fmt(v,0)],["spServ","Services publics (pt de PIB)",-1.5,2,0.1,v=>(v>0?"+":"")+fmt(v)],["taxMd","Hausse nette des impôts (Md€ par an ; change la part impôts / dépenses, pas le déficit)",-60,150,1,v=>(v>0?"+":"")+fmt(v,0)],["defense","Défense au-delà de la loi de programmation (pt PIB)",-1,2,0.1,v=>(v>0?"+":"")+fmt(v)],["rightsPts","Tension liée aux droits et libertés (points)",0,25,1,v=>fmt(v,0)]];
function compTable(p){ // répartition du programme par type de mesure (pt de PIB, application complète, réglages par défaut)
  const {c,resid,def}=fiscalCompDetail(p,BASE0);
  const rows=[]; for(const k of Object.keys(MULT)){let v=c[k]; if(k==="fonct") v-=resid+def; if(Math.abs(v)>=0.05) rows.push([MULTLABEL[k],v,k]);}
  if(Math.abs(def)>=0.05) rows.push(["Défense (loi de programmation et au-delà), comprise dans l'effort annoncé",def,"fonct"]);
  if(Math.abs(resid)>=0.05) rows.push(["Solde non détaillé jusqu'à l'effort annoncé (classé en fonctionnement)",resid,"fonct"]);
  if(!rows.length) return "";
  let layers=""; try{ const B=Object.assign({},typeof BASE!=="undefined"?BASE:BASE0), sq=simulate(CANDS0[0],"credible",B), r=simulate(p,"credible",B), y=yi(2032), sg=v=>(v>0?"+":v<0?"−":"")+fmt(Math.abs(v),2);
    layers=`<p class="src"><strong>Trois niveaux de chiffrage</strong> (méthode du CPB néerlandais et de l'OBR britannique ; + = déficit réduit, en pt de PIB) : annoncé ${sg(p.A)} · après comportements et crédibilité ${sg(r.progFull)} · effet sur le déficit 2032, effets sur l'activité et les intérêts compris, par rapport au statu quo ${sg(sq.def[y]-r.def[y])}.</p>`; }catch(e){}
  let wS=0,wL=0,tot=0; for(const [,v,k] of rows){wS+=Math.abs(v)*MULT[k][0];wL+=Math.abs(v)*MULT[k][2];tot+=Math.abs(v);}
  const flag=Math.abs(resid)>=1?`<p class="notice">Solde non détaillé important (${resid>0?"+":"−"}${fmt(Math.abs(resid),2)} pt) : c'est l'écart entre l'effort annoncé et la somme des mesures et curseurs listés. Faute de mieux, il est classé en dépenses de fonctionnement. Relever un curseur de dépense (climat, logement, services publics) sans changer l'effort annoncé réduit ce solde d'autant : l'effort total reste celui annoncé.</p>`:"";
  return layers+`<div class="tablewrap"><table class="mini"><thead><tr><th>Type de mesure</th><th>pt de PIB</th><th>Multiplicateur 1-2 ans / 10 ans</th></tr></thead><tbody>${rows.map(([l,v,k])=>`<tr><td>${l}</td><td class="${v>0?"better":"worse"}">${v>0?"+":"−"}${fmt(Math.abs(v),2)}</td><td>${fmt(MULT[k][0],1)} / ${fmt(MULT[k][2],1)}</td></tr>`).join("")}</tbody></table></div>${flag}<p class="src">+ : soutient l'activité (dépense ou baisse d'impôt) ; − : la freine (économie ou hausse d'impôt). Montants annoncés, avant évaporation des recettes sur les plus aisés. Multiplicateur moyen, pondéré par la taille de chaque poste : ${fmt(wS/tot,2)} à court terme, ${fmt(wL/tot,2)} à dix ans.${p.compNote?" "+p.compNote:""}</p>`;
}
function fillMultTable(){const el=document.getElementById("multtable"); if(!el) return;
  el.innerHTML=`<table class="mini"><thead><tr><th>Type de mesure</th><th>1-2 ans</th><th>5 ans</th><th>10 ans</th></tr></thead><tbody>${Object.keys(MULT).map(k=>`<tr><td>${MULTLABEL[k]}</td>${MULT[k].map(v=>`<td>${fmt(v,1)}</td>`).join("")}</tr>`).join("")}</tbody></table>`;}
function buildCands(){
  const box=document.getElementById("cands"); box.innerHTML="";
  for(const p of CANDS){ if(p.id==="statu") continue;
    const d=document.createElement("details"); d.className="cand"; d.id="fiche-"+p.id;
    d.innerHTML=`<summary><span class="sw" style="background:var(${p.color})"></span>${p.name}</summary>
      <div class="cbody"><div style="display:grid;gap:10px;min-width:0;align-content:start"><h3>Mesures retenues</h3><ul>${p.measures.map(m=>`<li>${m}</li>`).join("")}</ul>
      <p class="src">${p.why}</p><p class="src">${p.why2}</p><p class="src">${p.why3}</p>
      <h3>Effet sur le revenu des ménages (Md€ par an, application complète)</h3>
      <div class="tablewrap"><table class="mini"><thead><tr><th>Mesure</th><th>Md€</th><th>Qui est concerné</th><th>Origine</th></tr></thead><tbody>${p.paMeasures.map(([l,md,k,o,ch])=>`<tr><td>${l}</td><td class="${md>0?"better":md<0?"worse":""}">${md>0?"+":md<0?"−":""}${fmt(Math.abs(md),1)}</td><td>${KEYLABEL[k]}</td><td>${ORIG[o]||"–"}<span class="rng">${CHIF[ch]||""}</span></td></tr>`).join("")}</tbody></table></div><p class="src">Chiffrage revu le ${p.checked||"–"}. Une erreur ou un oubli ? <a href="https://github.com/mysteropodes/simulateur-2027/issues/new?template=contester-un-chiffrage.yml&amp;title=${encodeURIComponent("["+p.name+"] ")}" target="_blank" rel="noopener">Contester ou compléter ce chiffrage</a>.</p><p class="src">Sources : ${p.sources.map(([t,u])=>`<a href="${u}" target="_blank" rel="noopener">${t}</a>`).join(" · ")}</p><h3>Répartition de l'effort et effet sur l'activité</h3>${compTable(p)}</div>
      <div class="sliders">${PS.map(([k,l,mn,mx,st])=>`<div class="sl"><label for="${p.id}-${k}">${l} <output id="o-${p.id}-${k}"></output></label><input type="range" id="${p.id}-${k}" min="${mn}" max="${mx}" step="${st}"></div>`).join("")}</div></div>`;
    box.appendChild(d);
    for(const [k,,,,,f] of PS){const el=d.querySelector(`#${p.id}-${k}`),o=d.querySelector(`#o-${p.id}-${k}`);
      el.value=p[k];o.textContent=f(p[k]);el.oninput=()=>{p[k]=+el.value;o.textContent=f(+el.value);render()};}
  }
}
// Indicateurs rangés par thème : un thème, puis tous ses indicateurs visibles d'un clic
const THEMES=[["Finances publiques",["debt","def","burden","spread","po","dep","defEtat","defSecu","defLoc","nw","defense","ca"]],
 ["Croissance et emploi",["growth","unemp","youth","emp55","infl"]],
 ["Société",["pov","povA","gini","ratioEl","tension","health","sp"]],
 ["Retraites et patrimoine",["pens","retliv","w10","inh","succ"]],
 ["Justice et sécurité",["prisonD","judgeLoad","theftI","secCost"]],
 ["Logement",["house","rent","cons"]],
 ["Climat et énergie",["co2","heat","pm","energy","brent","artif"]],
 ["Démographie",["icf","births","mig"]]];
{const seen=new Set(THEMES.flatMap(t=>t[1])); const rest=Object.keys(METRICS).filter(k=>!seen.has(k)); if(rest.length) THEMES.push(["Autres",rest]);}
const mbox=document.getElementById("metrics"), tbox=document.getElementById("themes");
const themeOf=k=>THEMES.findIndex(t=>t[1].includes(k));
let themeIdx=Math.max(0,themeOf(metric));
function buildMetricButtons(){
  tbox.innerHTML=""; THEMES.forEach(([lab],i)=>{const b=document.createElement("button");b.type="button";b.textContent=lab;b.setAttribute("role","tab");b.setAttribute("aria-selected",i===themeIdx);
    b.onclick=()=>{themeIdx=i;if(themeOf(metric)!==i){metric=THEMES[i][1][0];render();}buildMetricButtons();};tbox.appendChild(b);});
  const tl=document.getElementById("trayl"); if(tl) tl.innerHTML=`Indicateurs du thème <b>${THEMES[themeIdx][0]}</b>`;
  mbox.innerHTML=""; for(const k of THEMES[themeIdx][1]){const b=document.createElement("button");b.type="button";b.textContent=METRICS[k][0];b.dataset.metric=k;b.setAttribute("aria-pressed",k===metric);
    b.onclick=()=>{metric=k;mbox.querySelectorAll("button").forEach(x=>x.setAttribute("aria-pressed",x===b));render()};mbox.appendChild(b);}
}
buildMetricButtons();
// Classement des programmes par part chiffrée de façon indépendante (Déchiffrer 2027), tirée de la note de crédibilité : d = (c − 0,3) / 0,7
(function(){
  const el=document.getElementById("costRank"); if(!el) return;
  const det={melenchon:"≈ 31 Md€ vérifiés sur ≈ 52",retailleau:"≈ 38 sur ≈ 144 (annuel impliqué par sa cible ; 197 cumulés)",philippe:"≈ 23 sur ≈ 170",lepen:"≈ 16 sur 140",glucksmann:"pas encore de programme chiffré",attal:"≈ 10 Md€ vérifiés sur 120 à 150"};
  // Prochaines étapes annoncées (vérifié le 30 octobre 2026)
  const nxt={melenchon:"<b>Annoncé :</b> programme le 6 novembre, convention au Bourget le 7 novembre, chiffrage complet début 2027",
    retailleau:"Aucune date annoncée pour un chiffrage complet",
    philippe:"Aucune date annoncée pour un chiffrage global (ordonnances prévues en juillet 2027)",
    lepen:"Aucune date annoncée pour un chiffrage complet",
    glucksmann:"Désigné le 11 octobre (primaire) ; aucune date annoncée pour son programme chiffré",
    attal:"Aucune date annoncée pour un chiffrage complet"};
  const rows=CANDS0.filter(p=>p.id!=="statu"&&!p.fictif).map(p=>({p,d:Math.max(0,(p.c-0.3)/0.7)})).sort((a,b)=>b.d-a.d);
  el.innerHTML='<div class="cr-h">Programmes les mieux chiffrés <span>part des recettes et économies annoncées (hors impôts sur les plus aisés) que Déchiffrer 2027 a pu vérifier, et prochains chiffrages annoncés, au 31 octobre 2026</span></div>'+
    rows.filter(r=>r.p.id!=="glucksmann").map((r,i)=>'<div class="cr-r"><span class="cr-n">'+(i+1)+'</span><span class="cr-c" style="background:var('+r.p.color+')"></span><span class="cr-name">'+r.p.name+'</span><span class="cr-bar"><i style="width:'+Math.round(r.d*100)+'%;background:var('+r.p.color+')"></i></span><span class="cr-v">'+Math.round(r.d*100)+' %</span><span class="cr-d">'+(det[r.p.id]||"")+(nxt[r.p.id]?'<br><span class="cr-x">'+nxt[r.p.id]+'</span>':'')+'</span></div>').join("")+
    '<div class="cr-r"><span class="cr-n">–</span><span class="cr-c" style="background:var('+CANDS0.find(p=>p.id==="glucksmann").color+')"></span><span class="cr-name">Glucksmann (PS-PP)</span><span></span><span class="cr-v">–</span><span class="cr-d">Programme pas encore publié : pas de classement possible. Le simulateur reconstitue son programme à partir de ses déclarations, avec la note de crédibilité minimale.<br><span class="cr-x">'+nxt.glucksmann+'</span></span></div>'+
    '<p class="help">Ce n\'est pas une note de sérieux du programme : un candidat peut chiffrer peu mais juste. Dans le simulateur, la part non vérifiée n\'est retenue qu\'à 30 % (note de crédibilité c = 0,3 + 0,7 × cette part), les dépenses et baisses d\'impôts étant retenues en entier.</p>';
})();
const PRESETS={keynes:{extScale:0.5,rcSupply:0.05,rcRent:5,uStructScale:0.5,crowd:0,povSave:2.7,smicEl:0.05,spRet:0.2,invRet:0,rtt:0.9,mult:1.0,multScale:1.25,hyst:0.1,ineqGrowth:0.12,importSub:0.7,transDrag:0,leak:0.15,prem:0.08,kDebt:0.12,crisisPrem:4.0,seniorKeep:0.45,mktReal:1.2},
  central:{extScale:1,rcSupply:0.15,rcRent:3,uStructScale:1,crowd:0.02,povSave:1.35,smicEl:0.35,spRet:0.1,invRet:0,rtt:0.5,mult:0.7,multScale:1,hyst:0.05,ineqGrowth:0.06,importSub:0.5,transDrag:0.06,leak:0.4,prem:0.15,kDebt:0.25,crisisPrem:3.0,seniorKeep:0.55,mktReal:1.5},
  liberal:{extScale:1.6,rcSupply:0.25,rcRent:1,uStructScale:1.6,crowd:0.04,povSave:0,smicEl:0.5,spRet:0.03,invRet:0,rtt:0.1,mult:0.4,multScale:0.7,hyst:0,ineqGrowth:0,importSub:0.3,transDrag:0.12,leak:0.6,prem:0.25,kDebt:0.4,crisisPrem:2.5,seniorKeep:0.65,mktReal:1.8}};
// lecture fondée sur les études faites après coup : valeurs centrales, sauf là où l'histoire tranche
PRESETS.historique=Object.assign({},PRESETS.central,{leak:0.54,seniorKeep:0.65});
const PRESETHELP={historique:"Lecture fondée sur l'historique : pour chaque hypothèse, la valeur la mieux étayée par les études faites après coup. Recettes perdues sur les plus riches : 54 % (Conseil d'analyse économique, 2025). Seniors restant en emploi quand l'âge de départ recule : 65 % (Insee, réforme de 2010 : 63 % des hommes, 73 % des femmes). Effets sur l'activité : valeurs centrales des études, plus fortes en crise (FMI, Blanchard et Leigh, 2013, déjà appliqué). Le reste, où l'histoire ne tranche pas (35 heures, réaction des marchés, inégalités et croissance), garde les valeurs centrales.",keynes:"Lecture keynésienne (proche de l'OFCE ou des Économistes atterrés) : les économies freinent fortement l'activité, la redistribution vers les modestes et l'investissement public la relancent, peu de recettes s'évaporent, les marchés sont patients.",
  central:"Hypothèses centrales : moyenne des estimations publiées.",
  liberal:"Lecture libérale (proche de l'iFRAP, de l'Institut Montaigne ou de Rexecode) : les économies coûtent peu en activité, la redistribution relance peu, une grande part des impôts sur les plus riches s'évapore, les marchés réagissent vite à la dette."};
let preset="central";
document.querySelectorAll("[data-preset]").forEach(b=>b.onclick=()=>{preset=b.dataset.preset;Object.assign(BASE,PRESETS[preset]);syncSeg("preset",preset);document.getElementById("presethelp").textContent=PRESETHELP[preset];bindGlobals();render()});
document.querySelectorAll("[data-mode]").forEach(b=>b.onclick=()=>{mode=b.dataset.mode;syncSeg("mode",mode);render()});
for(const k of ["shock","clim","ai","energy","exit"]) document.querySelectorAll(`[data-${k}]`).forEach(b=>b.onclick=()=>{BASE[k]=b.dataset[k];syncSeg(k,BASE[k]);render()});
document.getElementById("reset").onclick=()=>{try{history.replaceState(null,"",location.pathname+location.search);}catch(e){}BASE=structuredClone(BASE0);CANDS=structuredClone(CANDS0);bandCand="none";preset="central";syncSeg("preset","central");mode="credible";syncSeg("mode",mode);document.getElementById("presethelp").textContent=PRESETHELP.central;bindGlobals();buildCands();buildBandSel();render()};
window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change",render);
new MutationObserver(render).observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});
const KEYLABEL={minima:"surtout les 30 % les plus modestes",chomage:"chômeurs, surtout modestes et moyens",bassal:"salariés modestes",fonction:"agents publics, classes moyennes",retraites:"retraités",capital:"surtout les 10 % les plus riches",ir:"contribuables, surtout les plus aisés",conso:"tous, selon la consommation",tete:"tous, à parts égales",entreprises:"actionnaires, surtout les plus aisés",heuressup:"salariés, surtout classes moyennes",jeunes:"18-29 ans"};
function buildDeciles(){
  const tb=document.querySelector("#tbldec tbody");tb.innerHTML="";
  for(const p of CANDS){ if(p.id==="statu") continue; const tr=document.createElement("tr");
    tr.innerHTML=`<td class="name"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td>`+p.paDec.map((v,i)=>`<td class="${i===0?"sep ":""}${Math.abs(v)<0.05?"":v>0?"better":"worse"}">${v>0?"+":v<0?"−":""}${fmt(Math.abs(v))} %</td>`).join("");
    tb.appendChild(tr);}
}
const GRIDCRIT=[["egal","Égalité de traitement et discriminations"],["lib","Libertés publiques et maintien de l'ordre"],["cp","Contre-pouvoirs et État de droit"],["prob","Probité et lutte contre la corruption (hors tension sociale)"]];
const GLAB={renforce:["renforce","ok"],neutre:["peu de changement","neutral"],mixte:["mixte","mid"],restreint:["restreint","bad"]};
function buildGrid(){
  const box=document.getElementById("grid");box.innerHTML="";
  for(const p of CANDS0){ if(!p.grid) continue;
    const art=document.createElement("article");art.className="gcard";
    art.innerHTML=`<h3><span class="sw" style="background:var(${p.color})"></span>${p.name}</h3>`+GRIDCRIT.map(([k,l])=>{const [dir,what,def]=p.grid[k];const [lab,cl]=GLAB[dir];
      return `<div class="grow"><div class="ghead"><span class="eyebrow">${l}</span><span class="chip ${cl}">${lab}</span></div><p>${what}</p><p class="src">L’autre point de vue : ${def}</p></div>`;}).join("")+
      `<p class="src">Sources : ${p.gsrc.map(([t,u])=>`<a href="${u}" target="_blank" rel="noopener">${t}</a>`).join(" · ")}</p>`;
    box.appendChild(art);}
}

// ---- v6 : explications des inflexions, fourchettes d'incertitude, seniors et patrimoine
let LASTRES=null, MC=null, mcTimer=null, bandCand="none";
const ALLM=Object.keys(METRICS);
const EVMET={rights:["tension"],react:["debt","def","burden","unemp","growth","dep","po","spread","nw","tension"],start:ALLM,shock:ALLM,crisis:ALLM,bce:["debt","def","burden"],tpi:["debt","def","burden"],rating:["debt","def","burden"],
  retreat:["debt","def","burden","tension","pov","gini","unemp","pens","retliv","co2","pm","emp55","w10"],lr:["debt","def","burden","unemp"],age:["emp55","pens","unemp","retliv","debt","def"],oil:ALLM};
const MINCHG={ca:0.4,defEtat:0.5,defSecu:0.3,defLoc:0.2,house:3,rent:2,inh:0.3,succ:0.05,brent:10,mig:30,icf:0.03,births:15,nw:1.5,spread:0.3,defense:0.1,rating:1,growth:0.6,infl:0.6,youth:0.8,po:0.3,dep:0.5,energy:2,artif:500,cons:8,sp:0.2,ratioEl:0.05,debt:1.5,def:0.5,unemp:0.3,pov:0.3,gini:0.003,health:0.5,heat:400,tension:4,burden:0.5,co2:4,pm:400,pens:0.1,retliv:0.4,emp55:0.4,w10:0.1};
function hexA(h,a){const n=parseInt(h.replace("#",""),16);return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`;}
function tipFooter(items){
  if(!LASTRES||!items.length) return "";
  const t=+items[0].label, out=[];
  for(const it of items){const x=LASTRES[it.datasetIndex]; if(!x) continue;
    for(const e of x.r.ev) if(e.t===t&&(EVMET[e.k]||[]).includes(metric)) out.push(`${x.p.name} : ${e.txt}`);}
  return out.length?wrapLines(out,60):"";
}
function wrapLines(arr,n){const res=[];for(const s of arr){let line="";for(const w of s.split(" ")){if((line+" "+w).length>n){res.push(line);line=w;}else line=line?line+" "+w:w;}res.push(line);}return res;}
function commonCause(t,dl,m){
  const c=[];
  if(t===2027) c.push("début des mandats : les mesures de chaque programme commencent à s'appliquer");
  if(t===2031||t===2032) c.push("fin de la montée en charge des programmes (cinq ans)");
  if((m==="unemp"||m==="pov"||m==="tension")&&t>=2027&&t<=2033&&dl>0) c.push("pertes d'emplois liées à l'IA, qui culminent vers 2032");
  if((m==="unemp"||m==="pov"||m==="tension")&&t>=2034&&dl<0) c.push("résorption progressive des pertes d'emplois liées à l'IA");
  if(m==="pens"&&t>2030) c.push("vieillissement : le COR prévoit un déficit des retraites croissant après 2030");
  if(m==="heat") c.push("réchauffement : les décès liés à la chaleur augmentent chaque année");
  if(m==="emp55"&&t===2033) c.push("fin de la montée en charge de la réforme de 2023 (hypothèse)");
  return c;
}
function sg(v,d){const s=fmt(Math.abs(v),d);return (/^0(,0+)?$/.test(s)?"":v>0?"+":"−")+s;}
function explain(res){
  const box=document.getElementById("explain"); if(!box) return;
  const [ml,,dec,suf]=METRICS[metric], u=suf==="%"?" pt":suf;
  let html="";
  for(const {p,r} of res){
    const a=r[metric], d=[], items=[];
    for(let k=2;k<a.length;k++) d[k]=(a[k]==null||a[k-1]==null||a[k-2]==null)?null:(a[k]-a[k-1])-(a[k-1]-a[k-2]);
    const absd=d.filter(x=>x!=null).map(Math.abs).sort((x,y)=>x-y), med=absd[Math.floor(absd.length/2)]||0;
    const thr=Math.max(2.5*med,MINCHG[metric]);
    let last=-9;
    for(let k=2;k<a.length;k++){ const t=START+k;
      if(d[k]==null) continue;
      if(Math.abs(d[k])<thr||k-last<=1){ if(Math.abs(d[k])>=thr) last=k; continue;}
      last=k;
      const dl=a[k]-a[k-1], dPrev=a[k-1]-a[k-2];
      const evs=r.ev.filter(e=>(e.t===t||e.t===t-1)&&(EVMET[e.k]||[]).includes(metric)).map(e=>e.t===t?e.txt:`Effet de l'événement de ${e.t} : ${e.txt[0].toLowerCase()+e.txt.slice(1)}`);
      const causes=evs.length?evs:commonCause(t,dl,metric).map(s=>s[0].toUpperCase()+s.slice(1)+".");
      let deco="";
      if(metric==="debt") deco=` Décomposition : intérêts moins croissance ${sg(r.snow[k],1)} pt, déficit hors intérêts ${sg(r.prim[k],1)} pt.`;
      items.push(`<li><strong>${t}</strong> : ${sg(dl,dec)}${u} sur l'année, contre ${sg(dPrev,dec)}${u} l'année précédente.${deco} ${causes.length?causes.join(" "):"Pas d'événement particulier : effet cumulé des tendances (taux, croissance, chômage)."}</li>`);
      if(items.length>=4) break;
    }
    if(items.length) html+=`<div class="xp"><h3><span class="sw" style="background:var(${p.color})"></span>${p.name}</h3><ul>${items.join("")}</ul></div>`;
  }
  box.innerHTML=html||`<p class="help">Pas de rupture marquée pour « ${ml} » avec ces réglages : les courbes suivent des tendances régulières.</p>`;
}
// --- Monte-Carlo
function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
const NMC=200;
function scheduleMC(){clearTimeout(mcTimer);mcTimer=setTimeout(runMC,250);}
function pick(r,opts,w){let x=r(),s=0;for(let i=0;i<opts.length;i++){s+=w[i];if(x<s)return opts[i];}return opts[opts.length-1];}
function runMC(){
  const R=rng(2027), gauss=()=>Math.sqrt(-2*Math.log(R()+1e-12))*Math.cos(2*Math.PI*R());
  const draws=[];
  for(let n=0;n<NMC;n++){
    const b=Object.assign({},BASE);
    b.realg=Math.max(-0.5,BASE.realg+0.4*gauss()); b.mktReal=Math.max(0,BASE.mktReal+0.5*gauss()); b.infl=Math.max(0,BASE.infl+0.4*gauss());
    const rm=R()-0.5; b.mult=Math.max(0.2,BASE.mult+rm*0.6); b.multScale=Math.max(0.4,BASE.multScale+rm*0.5); b.hyst=Math.max(0,BASE.hyst+rm*0.1); b.ineqGrowth=Math.max(0,BASE.ineqGrowth+rm*0.1); // un seul tirage : les effets sur l'activité varient ensemble
    b.kDebt=Math.max(0,BASE.kDebt*(0.5+R())); b.crisisPrem=Math.max(1.5,BASE.crisisPrem-1+2*R());
    b.leak=Math.min(0.9,Math.max(0,BASE.leak+(R()-0.5)*0.4)); b.seniorKeep=Math.min(0.9,Math.max(0.2,BASE.seniorKeep+(R()-0.5)*0.3));
    b.clim=pick(R,["moderee","forte","tresforte"],[0.3,0.5,0.2]); b.ai=pick(R,["lente","moyenne","rapide"],[0.3,0.45,0.25]); if(BASE.energy==="tendance") b.energy=pick(R,["tendance","tensions","contrainte"],[0.6,0.3,0.1]);
    if(BASE.shock==="none"&&R()<0.4){b.shock=pick(R,["recession","financial","inflation","climat","petrole","commerce","guerre"],[0.22,0.18,0.13,0.15,0.13,0.1,0.09]);b.shockYear=2028+Math.floor(R()*13);}
    if(R()<0.25){b.shock2=pick(R,["recession","financial","climat","petrole","guerre"],[0.3,0.2,0.25,0.15,0.1]);b.shockYear2=2033+Math.floor(R()*13);} // un second choc sur vingt ans
    b.bceDraw=R(); b.tensionRights=BASE.tensionRights*(0.3+R()); b.socialMin=0.1+R()*0.25; b.tpiDef=BASE.tpiDef-0.75+1.5*R(); b.premPolDecay=0.6+0.35*R(); b.povSave=Math.max(0,BASE.povSave*(0.3+1.4*R())); b.smicEl=Math.max(0,BASE.smicEl+(R()-0.5)*0.4); b.extScale=0.3+1.5*R(); b.rcSupply=0.03+0.27*R(); b.rcRent=1+4*R(); // effets de l'encadrement des loyers : très débattus // filet BCE et effet du Smic : incertains
    const pj={}; for(const c of CANDS) pj[c.id]={adh:(R()-0.5)*0.3,co2:0.5+0.6*R()}; // jugements propres à chaque programme : soutien de l'opinion (±0,15) et efficacité de la politique climatique (50 à 110 % du rythme annoncé)
    draws.push({b,cj:(R()-0.5)*0.3,ej:0.5+R(),pj,us:0.3+1.2*R(),inf:0.5+2*R()}); // inf : diffusion des hausses de salaires (Smic, point d'indice) ou des baisses de taxes aux prix, de 50 à 250 % de l'hypothèse // us : effet des réformes du marché du travail sur le chômage structurel, de 30 à 150 % de l'hypothèse (débat sur l'assurance chômage et le Smic)
  }
  const q=(arr,x)=>{const s=[...arr].sort((a,b)=>a-b);return s[Math.min(s.length-1,Math.floor(x*s.length))];};
  MC={metric,rows:[],series:{}};
  for(const p of CANDS){
    const debt=[],up=[],pov=[],ser=[],cy=[];let cr=0,tp=0,emb=0,cr37=0,prog5=0;
    for(const {b,cj,ej,pj,us,inf} of draws){
      if(typeof setSocialKey==="function") setSocialKey(b.socialMin); // clé d'incidence des économies sociales non détaillées : part « minima » tirée entre 10 et 35 %
      const ms=microsim(p.paMeasures,mode==="annonce"?0:b.leak); const pp=Object.assign({},p,{c:Math.min(1,Math.max(0,p.c+(p.id==="statu"?0:cj))),eu:p.eu*ej,pa:ms.pa,paDec:ms.deciles,adh:Math.min(0.95,Math.max(0.05,(p.adh||0.5)+pj[p.id].adh)),co2Eff:pj[p.id].co2,uStruct:(p.uStruct||0)*us,inflImp:(p.inflImp||0)*inf});
      const r=simulate(pp,mode,b);
      debt.push(r.debt[yi(2036)]); up.push(Math.max(...r.unemp.slice(yi(2027),yi(2036)+1))); pov.push(r.pov[yi(2032)]);
      if(r.crisis!==null){cr++; cy.push(r.crisis); if(r.crisis<=2037) cr37++; if(r.crisisN>=2||Math.max(...r.tension.slice(r.crisis-2025))>=80) emb++; if(r.crisis<=2041&&(r.progEnds||[]).some(y=>y<=r.crisis+5)) prog5++;} else if(r.tpi!==null) tp++;
      ser.push(r[metric]);
    }
    const band=YEARS.map((_,k)=>{const col=ser.map(s=>s[k]).filter(v=>v!=null);return col.length?[q(col,0.1),q(col,0.5),q(col,0.9)]:[null,null,null];});
    MC.series[p.id]=band;
    MC.rows.push({p,debt:[q(debt,0.1),q(debt,0.5),q(debt,0.9)],up:[q(up,0.1),q(up,0.5),q(up,0.9)],pov:[q(pov,0.1),q(pov,0.5),q(pov,0.9)],cr:cr/NMC,tp:tp/NMC,cy:cy.length?[q(cy,0.1),q(cy,0.5),q(cy,0.9)]:null,cr37:cr37/NMC,emb:emb/NMC,prog5:prog5/NMC});
  }
  if(typeof setSocialKey==="function") setSocialKey(0.2);
  const tb=document.querySelector("#tblmc tbody"); if(tb){tb.innerHTML="";
    const rg=(a,d=0,s="")=>`${fmt(a[1],d)}${s} <span class="rng">${fmt(a[0],d)} – ${fmt(a[2],d)}</span>`;
    for(const x of MC.rows){const tr=document.createElement("tr");
      tr.innerHTML=`<td class="name"><span class="sw" style="background:var(${x.p.color})"></span>${x.p.name}</td><td class="sep">${rg(x.debt,0," %")}</td><td>${rg(x.up,1," %")}</td><td>${rg(x.pov,1," %")}</td><td class="sep ${x.cr>=0.25?"worse":x.cr<=0.05?"better":""}">${fmt(x.cr*100,0)} %</td><td>${fmt(x.tp*100,0)} %</td><td class="sep">${x.cy?`<strong>${x.cy[1]}</strong> <span class="rng">${x.cy[0]} – ${x.cy[2]}${x.cy[0]===x.cy[2]?"":""}</span><span class="rng">${fmt(x.cr37*100,0)} % de risque avant 2037</span>`:"Pas de crise"}</td><td class="${x.emb>=0.25?"worse":x.emb<=0.05?"better":""}">${fmt(x.emb*100,0)} %</td>`;
      tb.appendChild(tr);}}
  if(bandCand!=="none") render(true);
}
function addBand(ds){
  if(bandCand==="none"||!MC||MC.metric!==metric||!MC.series[bandCand]) return;
  const p=CANDS.find(c=>c.id===bandCand), col=css(p.color), b=MC.series[bandCand], dec=METRICS[metric][2];
  ds.push({label:"bas",isBand:true,data:b.map(v=>v[0]==null?null:+v[0].toFixed(dec+1)),borderWidth:0,pointRadius:0,pointHoverRadius:0,fill:false,tension:.25});
  ds.push({label:"haut",isBand:true,data:b.map(v=>v[2]==null?null:+v[2].toFixed(dec+1)),borderWidth:0,pointRadius:0,pointHoverRadius:0,fill:"-1",backgroundColor:hexA(col,0.16),tension:.25});
}
function fillSenior(res){
  const tb=document.querySelector("#tblsen tbody"); if(!tb) return; tb.innerHTML="";
  const sq=res[0].r;
  for(const {p,r} of res){const q=p.id==="statu";
    const e=r.emp55[yi(2032)], w=r.w10[yi(2036)], lost=(p.topRev||0)*(mode==="annonce"?0:BASE.leak);
    const tr=document.createElement("tr");
    tr.innerHTML=`<td class="name"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td>
      <td class="sep txt">${AGETXT[p.id]||""}</td>
      <td class="${q?"":Math.abs(e-sq.emp55[yi(2032)])<0.2?"":e>sq.emp55[yi(2032)]?"better":"worse"}">${fmt(e)} %</td>
      <td>${q?"–":(r.uSen>=0?"+":"−")+fmt(Math.abs(r.uSen),2)+" pt"}</td>
      <td class="sep">${p.topRev?fmt(p.topRev,0)+" Md€":"–"}</td><td class="${lost>0.5?"worse":""}">${p.topRev?fmt(lost,0)+" Md€":"–"}</td>
      <td class="sep">${fmt(w)} %</td>`;
    tb.appendChild(tr);}
}
const AGETXT={statu:"64 ans (réforme de 2023)",melenchon:"60 ans, 40 annuités",lepen:"60 à 62 ans selon l'âge d'entrée au travail",philippe:"65 ans, 45 annuités",glucksmann:"62 ans, adapté à la pénibilité",retailleau:"63 ans avec décote, taux plein à 65 ans",attal:"Plus d'âge légal : durée de cotisation, décote et surcote renforcées"};
function buildBandSel(){
  const s=document.getElementById("bandSel"); if(!s) return;
  s.innerHTML=`<option value="none">Aucune</option>`+CANDS.map(p=>`<option value="${p.id}">${p.name}</option>`).join("");
  s.value=bandCand; s.onchange=()=>{bandCand=s.value;render(true);};
}
buildBandSel();
const CASES=[{"id": "c1", "label": "Personne seule au Smic, locataire", "rd": 1680, "act": 1443, "ir": 0, "ppa": 238, "al": 0, "autres": 0, "smic": 166, "smicNet": 257, "apl": null, "flat": null, "csg": 107, "csgNet": 155, "rn30": null, "lr": -57, "lrH": 14, "lrCut": -72}, {"id": "c2", "label": "Parent seul, un enfant, Smic à mi-temps, locataire", "rd": 1795, "act": 722, "ir": 0, "ppa": 412, "al": 427, "autres": 0, "smic": 111, "smicNet": 128, "apl": 43, "flat": null, "csg": 77, "csgNet": 77, "rn30": null, "lr": -116, "lrH": 7, "lrCut": -124}, {"id": "c3", "label": "Couple, deux enfants, Smic et 1,5 Smic, locataire", "rd": 3893, "act": 3608, "ir": 0, "ppa": 134, "al": 0, "autres": 153, "smic": 192, "smicNet": 257, "apl": null, "flat": null, "csg": 177, "csgNet": 254, "rn30": null, "lr": -4, "lrH": 36, "lrCut": -40}, {"id": "c4", "label": "Jeune de 27 ans seul, 3 200 € brut, locataire", "rd": 2385, "act": 2533, "ir": 148, "ppa": 0, "al": 0, "autres": 0, "smic": null, "smicNet": null, "apl": null, "flat": null, "csg": 31, "csgNet": 36, "rn30": 148, "lr": 25, "lrH": 25, "lrCut": 0}, {"id": "c5", "label": "Couple de cadres, 6 000 € brut chacun, 30 000 € de dividendes, propriétaires", "rd": 9729, "act": 9530, "ir": 1836, "ppa": 0, "al": 0, "autres": 0, "smic": null, "smicNet": null, "apl": null, "flat": -395, "csg": null, "csgNet": null, "rn30": null, "lr": 95, "lrH": 95, "lrCut": 0}, {"id": "c6", "label": "Fonctionnaire territorial de catégorie C en début de carrière, seul, locataire", "rd": 1882, "act": 1779, "ir": 36, "ppa": 139, "al": 0, "autres": 0, "smic": null, "smicNet": null, "apl": null, "flat": null, "csg": 51, "csgNet": 113, "rn30": null, "lr": -27, "lrH": 14, "lrCut": -42}, {"id": "c7", "label": "Retraitée seule, 72 ans, pension de 1 200 € brut, locataire", "rd": 1263, "act": 1200, "ir": 0, "ppa": 0, "al": 63, "autres": 0, "smic": null, "smicNet": null, "apl": 6, "flat": null, "csg": null, "csgNet": null, "rn30": null, "lr": null, "lrH": null, "lrCut": null}, {"id": "c8", "label": "Couple de retraités, pensions de 2 800 € et 2 200 € brut, propriétaires", "rd": 4285, "act": 4545, "ir": 260, "ppa": 0, "al": 0, "autres": 0, "smic": null, "smicNet": null, "apl": null, "flat": null, "csg": null, "csgNet": null, "rn30": null, "lr": null, "lrH": null, "lrCut": null}];
function buildCases(){
  const tb=document.querySelector("#tblcases tbody"); if(!tb) return; tb.innerHTML="";
  const c=(v,net)=>v==null?`<td class="na">–</td>`:`<td class="${v>0?"better":v<0?"worse":""}">${v>0?"+":v<0?"−":""}${fmt(Math.abs(v),0)}&nbsp;€${net!=null?`<span class="rng">sur ${fmt(net,0)}&nbsp;€ de salaire net en plus</span>`:""}</td>`;
  for(const x of CASES){const tr=document.createElement("tr");
    tr.innerHTML=`<td class="txt">${x.label}</td><td class="sep">${fmt(x.rd,0)}&nbsp;€<span class="rng">dont prime d'activité ${fmt(x.ppa,0)}&nbsp;€, aide au logement ${fmt(x.al,0)}&nbsp;€</span></td>`+c(x.smic,x.smicNet)+c(x.apl)+c(x.flat)+`<td class="sep${x.csg>0?" better":""}">${x.csg==null?"–":"+"+fmt(x.csg,0)+"&nbsp;€"}${x.csgNet!=null?`<span class="rng">sur ${fmt(x.csgNet,0)}&nbsp;€ de CSG en moins</span>`:""}</td>`+c(x.rn30)+(x.lr==null?`<td class="sep na">–</td>`:`<td class="sep ${x.lr>0?"better":x.lr<0?"worse":""}">${x.lr>0?"+":x.lr<0?"−":""}${fmt(Math.abs(x.lr),0)}&nbsp;€<span class="rng">aides ${x.lrCut<0?"−":""}${fmt(Math.abs(x.lrCut),0)}&nbsp;€, heures +${fmt(x.lrH,0)}&nbsp;€</span></td>`);
    tb.appendChild(tr);}
  const td=document.querySelector("#tblcasedet tbody"); if(!td) return; td.innerHTML="";
  const e=v=>v?`${fmt(v,0)}&nbsp;€`:"–";
  for(const x of CASES){const tr=document.createElement("tr");
    tr.innerHTML=`<td class="txt">${x.label}</td><td class="sep">${e(x.act)}</td><td>${x.ir>0?"−"+fmt(x.ir,0)+"&nbsp;€":x.ir<0?"+"+fmt(-x.ir,0)+"&nbsp;€":"–"}</td><td>${e(x.ppa)}</td><td>${e(x.al)}</td><td>${e(x.autres)}</td><td class="sep"><strong>${fmt(x.rd,0)}&nbsp;€</strong></td>`;
    td.appendChild(tr);}
}
buildCases();
function fillHousing(res){
  const tb=document.querySelector("#tblhous tbody"); if(!tb) return; tb.innerHTML=""; const sq=res[0].r, y=yi(2032);
  for(const {p,r} of res){const q=p.id==="statu", cl=(v,ref,hb,eps)=>q||Math.abs(v-ref)<eps?"":(v>ref)===hb?"better":"worse";
    const tr=document.createElement("tr");
    tr.innerHTML=`<td class="name"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td>
      <td class="sep ${cl(r.cons[y],sq.cons[y],true,3)}">${fmt(r.cons[y],0)} 000</td><td class="txt">${HOUSTXT[p.id]}</td>
      <td class="sep ${cl(r.sp[y],sq.sp[y],true,0.05)}">${fmt(r.sp[y])} %</td>
      <td class="sep ${cl(r.ratioMon[y],sq.ratioMon[y],false,0.03)}">${fmt(r.ratioMon[y],2)}</td><td class="${cl(r.ratioEl[y],sq.ratioEl[y],false,0.02)}">${fmt(r.ratioEl[y],2)}</td>`;
    tb.appendChild(tr);}
}
function fillEco(res){
  const tb=document.querySelector("#tbleco tbody"); if(!tb) return; tb.innerHTML=""; const sq=res[0].r;
  const avg=(a,y0,y1)=>{let s=0;for(let y=y0;y<=y1;y++)s+=a[yi(y)];return s/(y1-y0+1);};
  for(const {p,r} of res){const q=p.id==="statu", cl=(v,ref,hb,eps)=>q||Math.abs(v-ref)<eps?"":(v>ref)===hb?"better":"worse";
    const g=avg(r.growth,2027,2036), gs=avg(sq.growth,2027,2036), inf=avg(r.infl,2027,2032), infs=avg(sq.infl,2027,2032);
    const tr=document.createElement("tr");
    tr.innerHTML=`<td class="name"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td>
      <td class="sep ${cl(g,gs,true,0.03)}">${fmt(g,2)} %</td><td class="${cl(inf,infs,false,0.03)}">${fmt(inf,2)} %</td>
      <td class="${cl(r.youth[yi(2030)],sq.youth[yi(2030)],false,0.2)}">${fmt(r.youth[yi(2030)])} %</td>
      <td class="sep">${fmt(r.po[yi(2032)])} %</td><td>${fmt(r.dep[yi(2032)])} %</td>
      <td class="sep ${cl(r.energy[yi(2035)],sq.energy[yi(2035)],false,0.5)}">${fmt(r.energy[yi(2035)],0)} Md€</td>
      <td class="${cl(r.artif[yi(2030)],sq.artif[yi(2030)],false,300)}">${fmt(Math.round(r.artif[yi(2030)]/100)*100,0)} ha</td>
      <td class="sep ${cl(r.nw[yi(2036)],sq.nw[yi(2036)],true,1)}">${sg(r.nw[yi(2036)],0)} %</td>`;
    tb.appendChild(tr);}
}
const NOTES=["A+","A","A−","BBB+","BBB","BBB−","BB+","BB"];
const EU25=[["Grèce",146.1],["Italie",137.1],["France",115.6],["Belgique",107.9],["Espagne",100.7],["Portugal",89.7],["Allemagne",63.5]];
const ART={"Grèce":"la Grèce","Italie":"l'Italie","Belgique":"la Belgique","Espagne":"l'Espagne","Portugal":"le Portugal","Allemagne":"l'Allemagne"};
function placeDebt(v){const o=EU25.filter(x=>x[0]!=="France");const above=o.filter(x=>x[1]>v);if(!above.length)return "au-dessus de la Grèce aujourd'hui (146 %)";const a=above[above.length-1];const below=o.find(x=>x[1]<=v);return below?`entre ${ART[below[0]]} (${fmt(below[1],0)} %) et ${ART[a[0]]} (${fmt(a[1],0)} %) aujourd'hui`:`sous ${ART[a[0]]} aujourd'hui (${fmt(a[1],0)} %)`;}
function fillIntl(res){
  const tb=document.querySelector("#tblintl tbody"); if(!tb) return; tb.innerHTML=""; const sq=res[0].r;
  for(const {p,r} of res){const q=p.id==="statu", cl=(v,ref,hb,eps)=>q||Math.abs(v-ref)<eps?"":(v>ref)===hb?"better":"worse";
    const n=Math.min(NOTES.length-1,r.rating[yi(2032)]), ns=Math.min(NOTES.length-1,sq.rating[yi(2032)]);
    const tr=document.createElement("tr");
    tr.innerHTML=`<td class="name"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td>
      <td class="sep ${cl(r.spread[yi(2030)],sq.spread[yi(2030)],false,0.05)}">${fmt(r.spread[yi(2030)],2)} pt</td>
      <td class="${q?"":n<ns?"better":n>ns?"worse":""}">${NOTES[n]}</td>
      <td class="sep">${fmt(r.defense[yi(2035)],2)} %</td>
      <td class="sep txt">${fmt(r.debt[yi(2036)],0)} % : ${placeDebt(r.debt[yi(2036)])}</td>`;
    tb.appendChild(tr);}
}
const HOUSTXT={statu:"Tendance : 265 000 en 2025, reprise lente",melenchon:"400 000 logements abordables par an dont 200 000 publics, 12 Md€ par an ; fin des aides à l'investissement locatif, encadrement des loyers partout",lepen:"Assouplissement du DPE ; programme logement non publié",philippe:"Programme logement non publié",glucksmann:"Encadrement des loyers en zones tendues ; programme logement partiel",retailleau:"Statut du bailleur (amortissement 4 %), fin de l'encadrement des loyers et des interdictions de louer liées au DPE, suppression du ZAN",attal:"Loi de programmation du logement sur cinq ans (non chiffrée)"};

// ---- onglets et tableau « crise de la dette »
function crisisTable(){
  const tb=document.querySelector("#tblcrisis tbody"); if(!tb) return;
  const R=rng(2046), gauss=()=>Math.sqrt(-2*Math.log(R()+1e-12))*Math.cos(2*Math.PI*R());
  const raw=[]; for(let n=0;n<NMC;n++) raw.push({g1:gauss(),g2:gauss(),g3:gauss(),u:[R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R(),R()]});
  const out={};
  for(const pk of ["keynes","central","liberal"]){
    const B0=Object.assign({},BASE,PRESETS[pk]);
    for(const p of CANDS){
      const ms0=microsim(p.paMeasures,mode==="annonce"?0:B0.leak); const r0=simulate(Object.assign({},p,{pa:ms0.pa,paDec:ms0.deciles}),mode,B0); let cr=0,tp=0;
      for(const d of raw){const b=Object.assign({},B0),u=d.u;
        b.realg=Math.max(-0.5,B0.realg+0.4*d.g1); b.mktReal=Math.max(0,B0.mktReal+0.5*d.g2); b.infl=Math.max(0,B0.infl+0.4*d.g3);
        b.mult=Math.max(0.2,B0.mult+(u[0]-0.5)*0.6); b.multScale=Math.max(0.4,B0.multScale+(u[0]-0.5)*0.5); b.hyst=Math.max(0,B0.hyst+(u[0]-0.5)*0.1); b.ineqGrowth=Math.max(0,B0.ineqGrowth+(u[0]-0.5)*0.1); b.kDebt=Math.max(0,B0.kDebt*(0.5+u[1])); b.crisisPrem=Math.max(1.5,B0.crisisPrem-1+2*u[2]);
        b.leak=Math.min(0.9,Math.max(0,B0.leak+(u[3]-0.5)*0.4)); b.seniorKeep=Math.min(0.9,Math.max(0.2,B0.seniorKeep+(u[4]-0.5)*0.3));
        b.bceDraw=u[11]; b.tpiDef=B0.tpiDef-0.75+1.5*u[14]; b.premPolDecay=0.6+0.35*u[16]; b.povSave=Math.max(0,B0.povSave*(0.3+1.4*u[17])); b.smicEl=Math.max(0,B0.smicEl+(u[15]-0.5)*0.4); b.clim=u[5]<0.3?"moderee":u[5]<0.8?"forte":"tresforte"; b.ai=u[6]<0.3?"lente":u[6]<0.75?"moyenne":"rapide"; if(BASE.energy==="tendance") b.energy=u[13]<0.6?"tendance":u[13]<0.9?"tensions":"contrainte";
        if(BASE.shock==="none"&&u[7]<0.4){b.shock=u[8]<0.25?"recession":u[8]<0.45?"financial":u[8]<0.6?"inflation":u[8]<0.75?"climat":u[8]<0.87?"petrole":u[8]<0.95?"commerce":"guerre";b.shockYear=2028+Math.floor(u[9]*13);}
        if(u[18]<0.25){b.shock2=u[19]<0.3?"recession":u[19]<0.5?"financial":u[19]<0.75?"climat":u[19]<0.9?"petrole":"guerre";b.shockYear2=2033+Math.floor(u[20]*13);}
        const ms=microsim(p.paMeasures,mode==="annonce"?0:b.leak); const pp=Object.assign({},p,{eu:p.eu*(0.5+u[12]),c:Math.min(1,Math.max(0,p.c+(p.id==="statu"?0:(u[10]-0.5)*0.3))),pa:ms.pa,paDec:ms.deciles});
        const r=simulate(pp,mode,b); if(r.crisis!==null) cr++; else if(r.tpi!==null) tp++;}
      (out[p.id]=out[p.id]||{})[pk]={r0,cr:cr/NMC,tp:tp/NMC};
    }
  }
  tb.innerHTML="";
  for(const p of CANDS){const tr=document.createElement("tr");
    tr.innerHTML=`<td class="name"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td>`+["keynes","central","liberal"].map((pk,i)=>{const x=out[p.id][pk];
      const main=x.r0.crisis!==null?`Crise en ${x.r0.crisis}`:x.r0.tpi!==null?`Filet BCE en ${x.r0.tpi}`:"Pas de crise";
      const cls=x.cr>=0.5?"worse":x.cr<=0.1?"better":"";
      return `<td class="cr ${i===0?"sep ":""}${cls}"><b>${main}</b>crise dans ${fmt(x.cr*100,0)} % des tirages${x.tp>0?`, filet BCE dans ${fmt(x.tp*100,0)} %`:""}</td>`;}).join("");
    tb.appendChild(tr);}
}
// Navigation : une vue à la fois (menu latéral, ou rangée d'onglets sur téléphone)
function showView(id,noScroll){
  const views=[...document.querySelectorAll(".view")]; if(!views.some(v=>v.dataset.view===id)) id="overview";
  for(const v of views) v.hidden=v.dataset.view!==id;
  document.querySelectorAll("[data-go]").forEach(b=>b.setAttribute("aria-current",b.dataset.go===id?"page":"false"));
  const v=views.find(x=>x.dataset.view===id); document.getElementById("viewTitle").textContent=v.dataset.title; document.getElementById("viewSub").textContent=v.dataset.sub;
  if(id==="dette"){const tb=document.querySelector("#tblcrisis tbody");tb.innerHTML=`<tr><td colspan="4" class="help">Calcul en cours…</td></tr>`;setTimeout(crisisTable,40);}
  else if(id==="retro"){setTimeout(()=>{if(typeof buildRetro==="function") buildRetro();},30);}
  else if(id==="atlas"){setTimeout(()=>{if(typeof buildAtlas==="function") buildAtlas();},30);}
  else if(id==="overview"&&chart) chart.resize();
  const mb=document.querySelector(`.mnav [data-go="${id}"]`); if(mb) mb.scrollIntoView({block:"nearest",inline:"center"});
  if(!noScroll) window.scrollTo({top:0});
  try{localStorage.setItem("simView",id);}catch(e){}
}
document.querySelectorAll("[data-go]").forEach(b=>b.onclick=()=>showView(b.dataset.go));
{let v0="overview"; try{v0=localStorage.getItem("simView")||"overview";}catch(e){} showView(v0,true);}
// Panneau « Hypothèses »
const drawer=document.getElementById("drawer"), scrim=document.getElementById("scrim"), openBtn=document.getElementById("openHyp");
function openDrawer(tab){drawer.hidden=false;scrim.hidden=false;openBtn.setAttribute("aria-expanded","true");document.body.classList.add("noscroll");if(tab) setDTab(tab);drawer.querySelector(".dclose").focus();}
function closeDrawer(){drawer.hidden=true;scrim.hidden=true;openBtn.setAttribute("aria-expanded","false");document.body.classList.remove("noscroll");openBtn.focus();}
function setDTab(t){drawer.querySelectorAll("[data-dtab]").forEach(b=>b.setAttribute("aria-selected",b.dataset.dtab===t));drawer.querySelectorAll("[data-dpane]").forEach(p=>p.hidden=p.dataset.dpane!==t);}
openBtn.onclick=()=>openDrawer(); document.getElementById("closeHyp").onclick=closeDrawer; scrim.onclick=closeDrawer;
drawer.querySelectorAll("[data-dtab]").forEach(b=>b.onclick=()=>setDTab(b.dataset.dtab));
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!drawer.hidden) closeDrawer();});
// Pastilles du scénario en cours (un clic ouvre le panneau)
const MODELAB={annonce:"Tel qu'annoncé",credible:"Si élu, chiffrage crédible",pondere:"Pondéré par la faisabilité"};
const PRESETLAB={keynes:"Keynésienne",central:"Centrale",liberal:"Libérale",historique:"Fondée sur l'historique"};
// Scénario en cours : trois menus déroulants dans la barre du haut ; le choix s'applique tout de suite, avec un message de confirmation
const SCEN=[["mode","Application",()=>mode,"credible",MODELAB],["preset","Lecture",()=>preset,"central",PRESETLAB],["shock","Choc",()=>BASE.shock,"none",null]];
let scenOpen=null, toastT=null;
function scenOpts(attr){return [...document.querySelectorAll(`.drawer [data-${attr}]`)].map(b=>[b.dataset[attr],b.textContent.trim()]);}
function updateChips(){
  const box=document.getElementById("scenChips"); if(!box) return;
  const changed=SCEN.some(([a,,get,def])=>get()!==def);
  box.innerHTML=`<span class="scenlab">Scénario</span>`+SCEN.map(([a,lab,get,def])=>{const v=get(), o=scenOpts(a).find(x=>x[0]===v), txt=(o?o[1]:v)+(a==="shock"&&v!=="none"?" en "+BASE.shockYear:"");
    return `<div class="dd"><button type="button" class="chip${v!==def?" changed":""}" data-chip="${a}" aria-haspopup="listbox" aria-expanded="${scenOpen===a}"><span>${lab}</span>${txt}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3"/></svg></button>${scenOpen===a?`<div class="ddmenu" role="listbox" aria-label="${lab}">${scenOpts(a).map(([k,t])=>`<button type="button" role="option" aria-selected="${k===v}" data-opt="${k}"><i>${k===v?"✓":""}</i>${t}${k===def?'<em>par défaut</em>':""}</button>`).join("")}</div>`:""}</div>`;}).join("")+(changed?`<button type="button" class="chipreset" id="scenReset">Revenir au scénario par défaut</button>`:"");
  box.querySelectorAll("[data-chip]").forEach(b=>b.onclick=e=>{e.stopPropagation();scenOpen=scenOpen===b.dataset.chip?null:b.dataset.chip;updateChips();const m=box.querySelector(".ddmenu [aria-selected=true]");if(m)m.focus();});
  box.querySelectorAll(".ddmenu [data-opt]").forEach(o=>o.onclick=e=>{e.stopPropagation();const a=o.closest(".dd").querySelector("[data-chip]").dataset.chip, k=o.dataset.opt;scenOpen=null;applyScen(a,k);});
  const r=document.getElementById("scenReset"); if(r) r.onclick=()=>{scenOpen=null;for(const [a,,get,def] of SCEN) if(get()!==def){const b=document.querySelector(`.drawer [data-${a}="${def}"]`); if(b) b.click();} toast("Scénario par défaut rétabli : chiffrage crédible, lecture centrale, aucun choc.");};
}
function applyScen(a,k){
  const b=document.querySelector(`.drawer [data-${a}="${k}"]`); if(b) b.click(); else updateChips();
  const lab=SCEN.find(x=>x[0]===a)[1], t=(scenOpts(a).find(x=>x[0]===k)||[k,k])[1];
  toast(`${lab} : « ${t} » appliqué. Les courbes et les tableaux sont recalculés.`);
  const c=document.querySelector(`[data-chip="${a}"]`); if(c){c.classList.add("flash");setTimeout(()=>c.classList.remove("flash"),900);}
}
function toast(msg){let t=document.getElementById("toast"); if(!t){t=document.createElement("div");t.id="toast";t.className="toast";t.setAttribute("role","status");t.setAttribute("aria-live","polite");document.body.appendChild(t);} t.textContent=msg; t.classList.add("on"); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove("on"),3200);}
document.addEventListener("click",()=>{if(scenOpen){scenOpen=null;updateChips();}});
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&scenOpen){scenOpen=null;updateChips();}});
// Vue d'ensemble : une carte par programme
function buildOverview(res,nc){
  const box=document.getElementById("ovCards"); if(!box) return; const yi=y=>y-START;
  box.innerHTML=res.map(({p,r})=>{const [nm,party]=p.id==="statu"?["Statu quo","aucune mesure nouvelle"]:[p.name.replace(/ \(.*/,""),(p.name.match(/\((.*)\)/)||[])[1]||""];
    return `<button type="button" class="ovcard${p.id==="statu"?" ref":""}" data-id="${p.id}" style="--c:var(${p.color})">
    <span class="ovn"><i></i>${nm}</span><span class="ovp">${party}</span>
    <span class="ovbig">${r.crisis||"—"}</span><span class="ovlab">${r.crisis?"crise de la dette":"pas de crise d'ici 2046"}</span>
    <dl><dt>Pauvreté</dt><dd>${fmt(r.pov[yi(2032)],1)} %</dd><dt>Chômage</dt><dd>${fmt(r.unemp[yi(2032)],1)} %</dd><dt>Tension</dt><dd>${fmt(r.tension[yi(2032)],0)}</dd><dt>Dette*</dt><dd>${fmt(nc(p).debt[yi(2046)],0)} %</dd></dl>${p.id==="glucksmann"?'<span class="ovtag" title="Programme pas encore publié : reconstitué à partir de ses déclarations et du chiffrage partiel de Déchiffrer 2027">programme reconstitué</span>':""}${p.fictif?'<span class="ovtag" title="Candidat qui n\'existe pas : programme construit par le simulateur à partir de mesures des programmes réels, sous contraintes de faisabilité (voir la Méthode)">candidat fictif</span>':""}</button>`;}).join("");
  box.querySelectorAll(".ovcard").forEach(b=>b.onclick=()=>{const id=b.dataset.id; if(id==="statu") return; showView("cands"); const d=document.getElementById("fiche-"+id); if(d){d.open=true;setTimeout(()=>d.scrollIntoView({block:"start"}),50);}});
}


// partage : tous les écarts aux réglages par défaut sont gardés dans l'adresse (#s=…)
const SHARE_BASE_KEYS=()=>[...GL.map(([k])=>k),"shock","clim","ai","energy","exit"];
function encodeState(){
  const st={v:1,m:mode,p:preset,k:metric,b:{},c:{}};
  for(const k of SHARE_BASE_KEYS()) if(BASE[k]!==BASE0[k]) st.b[k]=BASE[k];
  for(const c of CANDS){const c0=CANDS0.find(x=>x.id===c.id); const d={}; for(const [k] of PS) if(c[k]!==c0[k]) d[k]=c[k]; if(Object.keys(d).length) st.c[c.id]=d;}
  return btoa(JSON.stringify(st)).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
}
function decodeState(h){
  try{ const m=/[#&]s=([A-Za-z0-9_-]+)/.exec(h||""); if(!m) return false;
    let b64=m[1].replace(/-/g,"+").replace(/_/g,"/"); while(b64.length%4) b64+="=";
    const st=JSON.parse(atob(b64)); if(!st||st.v!==1) return false;
    if(["annonce","credible","pondere"].includes(st.m)) mode=st.m;
    if(PRESETS[st.p]) preset=st.p;
    if(METRICS[st.k]) metric=st.k;
    const keys=SHARE_BASE_KEYS();
    for(const [k,v] of Object.entries(st.b||{})) if(keys.includes(k)&&typeof v===typeof BASE0[k]) BASE[k]=v;
    for(const [id,d] of Object.entries(st.c||{})){const c=CANDS.find(x=>x.id===id); if(!c) continue;
      for(const [k,v] of Object.entries(d)) if(PS.some(([kk])=>kk===k)&&typeof v==="number"&&isFinite(v)) c[k]=v;}
    return true;
  }catch(e){return false;}
}
let shareTimer=null;
function updateShareURL(){clearTimeout(shareTimer);shareTimer=setTimeout(()=>{try{
  const s=encodeState(), def=s===encodeStateDefault; history.replaceState(null,"",location.pathname+location.search+(def?"":"#s="+s));}catch(e){}},300);}
document.getElementById("share").onclick=async()=>{
  const s=encodeState(), url=location.origin+location.pathname+location.search+(s===encodeStateDefault?"":"#s="+s), msg=document.getElementById("sharemsg");
  try{await navigator.clipboard.writeText(url);msg.textContent="Lien copié.";}
  catch(e){msg.textContent="Copiez ce lien : "+url;}
  setTimeout(()=>{msg.textContent="";},6000);
};
encodeStateDefault=encodeState();
if(decodeState(location.hash)){syncSeg("mode",mode);syncSeg("preset",preset);document.getElementById("presethelp").textContent=PRESETHELP[preset];
  themeIdx=Math.max(0,themeOf(metric)); buildMetricButtons();}
bindGlobals(); buildCands(); buildGrid(); fillMultTable(); render();

// Conséquences concrètes : tension sociale forte et crise de financement, par programme (calculées à chaque changement de réglage)
function buildConseq(res){
  const el=document.getElementById("conseq"); if(!el) return;
  const Y0=2025, f1=v=>fmt(v,1);
  const rows=res.map(({p,r})=>{
    const yrs=[]; r.tension.forEach((v,i)=>{if(i>=2&&v>60) yrs.push(Y0+i);});
    const peakT=Math.max(...r.tension.slice(1)), ret=Math.max(...r.retreat), gdpL=Math.min(...r.tensGdp);
    let cr="Aucune d'ici 2046";
    if(r.crisis){const k=r.crisis-Y0, w=r.unemp.slice(k,k+5), pv=r.pov.slice(k,k+5);
      const pe=(r.progEnds||[])[0], dur=pe?pe-r.crisis:(2046-r.crisis>=5?"plus de "+(2046-r.crisis):null);
      cr=`<b>${r.crisis}</b>${r.crisisLast&&r.crisisLast!==r.crisis?" puis rechute en "+r.crisisLast:""} : chômage jusqu'à ${f1(Math.max(...w))} % (${f1(r.unemp[k-1])} % avant), pauvreté jusqu'à ${f1(Math.max(...pv))} %, ${BASE.exit==="refus"?"contrôle des capitaux et inflation":"économies imposées de 1,5 pt de PIB par an"}${dur&&BASE.exit!=="refus"?` ; programme ${typeof dur==="number"?(dur>5?"prolongé à "+dur+" ans":"de 5 ans")+(r.tpi&&pe===r.tpi?", puis filet de la BCE":""):"toujours en cours en 2046 ("+dur+" ans)"}`:""}`;}
    const tens=yrs.length?`<b>${yrs.length} an${yrs.length>1?"s":""}</b> au-dessus de 60, dès ${yrs[0]} (pic ${fmt(peakT,0)})`:`Jamais au-dessus de 60 (pic ${fmt(peakT,0)})`;
    const back=p.id==="statu"?"–":ret>=1?`${fmt(ret,0)} % du programme abandonné`:"Aucun";
    const cost=gdpL<-0.005?`−${fmt(-gdpL,2)} % de PIB au pire moment`:"Négligeable";
    return `<tr><td class="txt"><span class="sw" style="background:var(${p.color})"></span>${p.name}</td><td>${tens}</td><td>${back}</td><td>${cost}</td><td>${cr}</td></tr>`;}).join("");
  el.innerHTML=`<p class="help">Selon les réglages en cours (lecture, mode, chocs). Tension sociale sur 100 : 40 en temps normal.</p>
  <div class="tblwrap"><table class="conseq"><thead><tr><th>Programme</th><th>Tension sociale forte</th><th>Recul du gouvernement</th><th>Activité perdue (grèves, blocages)</th><th>Crise de financement</th></tr></thead><tbody>${rows}</tbody></table></div>
  <p class="help"><b>Au-dessus de 60</b>, le simulateur suppose des mobilisations durables : le gouvernement recule sur une partie de son programme (jusqu'à 40 % à 80 de tension), les économies et les recettes prévues ne se font pas, et l'activité ralentit tant que la tension dure (0,01 % de PIB par point au-dessus de 60). Repères : plan Juppé sur les retraites retiré en 1995, CPE retiré en 2006, gilets jaunes en 2018 (taxe carbone gelée, environ 10 Md€ de mesures d'urgence, −0,1 point de PIB au 4e trimestre selon l'Insee). <b>Une crise de financement</b> (taux qui s'envolent, l'État ne trouve plus à emprunter à un prix supportable) entraîne récession, chômage, pauvreté et économies imposées en échange de prêts européens, comme en Grèce, au Portugal et en Irlande en 2010-2012 ; la tension monte alors brutalement, sans que le gouvernement l'ait choisi. Non modélisé : violences, crise politique ou institutionnelle, dissolution.</p>`;
}
